From c5f9c96ad8eb536bb19001f9636c3bc59721f396 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Mon, 2 Jan 2023 23:21:37 +0400
Subject: [PATCH] arm64: dts: mediatek: mt6755: Add clock controllers

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6755.dtsi | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6755.dtsi b/arch/arm64/boot/dts/mediatek/mt6755.dtsi
index 8e5d58f55971..1577c111d0d2 100644
--- a/arch/arm64/boot/dts/mediatek/mt6755.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6755.dtsi
@@ -99,6 +99,30 @@ uart_clk: dummy26m {
 		#clock-cells = <0>;
 	};
 
+	topckgen: clock-controller@10000000 {
+		compatible = "mediatek,mt6755-topckgen", "mediatek,topckgen";
+		reg = <0x10000000 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	infracfg_ao: clock-controller@10001000 {
+		compatible = "mediatek,infracfg_ao", "syscon";
+		reg = <0x10001000 0x1000>;
+		interrupts = <GIC_SPI 136 IRQ_TYPE_EDGE_RISING>;
+	};
+
+	infrasys: clock-controller@10001000 {
+		compatible = "mediatek,mt6755-infrasys";
+		reg = <0x10001000 0x1000>;
+		#clock-cells = <1>;
+	};
+
+	apmixedsys: clock-controller@1000c000 {
+		compatible = "mediatek,mt6755-apmixedsys", "mediatek,apmixed";
+		reg = <0x1000c000 0x1000>, <0x10006000 0x1000>;
+		#clock-cells = <1>;
+	};
+
 	timer {
 		compatible = "arm,armv8-timer";
 		interrupt-parent = <&gic>;
-- 
