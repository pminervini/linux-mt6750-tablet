From 2d990675dffd5b84963e7de8a1e748808042a116 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Tue, 3 Jan 2023 01:06:00 +0400
Subject: [PATCH] fixup! [HACK] arm64: dts: mt6755-nokia-es2: add simplefb

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
index 59e85e6c1e9f..dce0529bc2d4 100644
--- a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
@@ -21,12 +21,17 @@ aliases {
 	chosen {
 		stdout-path = &framebuffer0;
 
+		/*
+		 * HACK: Use display framebuffer setup by the lk bootloader for simplefb
+		 * FIXME: only text is rendered on VT (TTY) as an unknown bit has to be flipped to disable
+		 *        image compression!
+		 */
 		framebuffer0: framebuffer@7f1a0000 {
 			compatible = "simple-framebuffer";
 			reg = <0x0 0x7f1a0000 0x0 0x00e20000>;
 			width = <720>;
 			height = <1440>;
-			stride = <((720 + 4) * 4)>;
+			stride = <((720 + 16) * 4)>;
 			format = "a8r8g8b8";
 		};
 	};
