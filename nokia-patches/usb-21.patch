From 0b0618bbadea2555b5ec4c438892151ca40df59b Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Sat, 7 Jan 2023 09:45:49 +0400
Subject: [PATCH] arm64: dts: mediatek: mt6755-nokia-es2: Enable USB

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
index dce0529bc2d4..d167188d82d1 100644
--- a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
@@ -80,3 +80,12 @@ memory@40000000 {
 &uart0 {
 	status = "okay";
 };
+
+&ssusb {
+	dr_mode = "host";
+	status = "okay";
+};
+
+&usb3phy {
+	status = "okay";
+};
