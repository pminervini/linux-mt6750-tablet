From 70070b51b984c5ad21bc0435e9662811b55ab1ea Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Mon, 2 Jan 2023 08:29:53 +0400
Subject: [PATCH] arm64: dts: mediatek: mt6755: Add watchdog

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6755.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6755.dtsi b/arch/arm64/boot/dts/mediatek/mt6755.dtsi
index 0e21e3867f82..8e5d58f55971 100644
--- a/arch/arm64/boot/dts/mediatek/mt6755.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6755.dtsi
@@ -132,6 +132,12 @@ gic: interrupt-controller@10231000 {
 		      <0 0x10236000 0 0x2000>;
 	};
 
+	watchdog@10007000 {
+		compatible = "mediatek,mt6755-wdt",
+					"mediatek,mt6589-wdt";
+		reg = <0 0x10007000 0 0x100>;
+	};
+
 	uart0: serial@11002000 {
 		compatible = "mediatek,mt6755-uart",
 			     "mediatek,mt6577-uart";
-- 
