From 87fae71824101ea6a7314922c9c5a48dc4816057 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Mon, 2 Jan 2023 08:37:54 +0400
Subject: [PATCH] [HACK] arm64: dts: mt6755-nokia-es2: add simplefb

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
index 3e3689b53cdd..59e85e6c1e9f 100644
--- a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
@@ -19,7 +19,16 @@ aliases {
 	};
 
 	chosen {
-		stdout-path = "serial0:921600n8";
+		stdout-path = &framebuffer0;
+
+		framebuffer0: framebuffer@7f1a0000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x7f1a0000 0x0 0x00e20000>;
+			width = <720>;
+			height = <1440>;
+			stride = <((720 + 4) * 4)>;
+			format = "a8r8g8b8";
+		};
 	};
 
 	/* /reserved-memory has to exist even if practically empty or bootloader will be unhappy */
-- 
