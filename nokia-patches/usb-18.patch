From 763f55734bf9378a7ca07d7aaaa6538e434758e2 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Sat, 7 Jan 2023 04:35:26 +0400
Subject: [PATCH] arm64: dts: mediatek: mt6755: Refactor

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 .../boot/dts/mediatek/mt6755-nokia-es2.dts    |   4 +
 arch/arm64/boot/dts/mediatek/mt6755.dtsi      | 135 ++++++++++--------
 2 files changed, 77 insertions(+), 62 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
index dce0529bc2d4..7e6441c401dd 100644
--- a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
@@ -80,3 +80,7 @@ memory@40000000 {
 &uart0 {
 	status = "okay";
 };
+
+&uart1 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6755.dtsi b/arch/arm64/boot/dts/mediatek/mt6755.dtsi
index 49e7f2f0e5fd..4bb9edc7c3ae 100644
--- a/arch/arm64/boot/dts/mediatek/mt6755.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6755.dtsi
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
  * Copyright (c) 2016 MediaTek Inc.
- * Author: Mars.C <mars.cheng@mediatek.com>
+ * Copyright (c) 2023 Arseniy Velikanov <adomerlee@gmail.com>
  */
 
 #include <dt-bindings/interrupt-controller/irq.h>
@@ -89,32 +89,18 @@ chosen {
 		 * bootloader will be unhappy, also needs "bootopt=64S3,32N2,64N2"
 		 * on boot.img cmdline to boot 64-bit kernel (adding it here doesn't help)
 		 * FIXME: without "maxcpus=0" the kernel will panic while bringing up the secondary CPUs!
+		 * FIXME: without "initrd=..." initrd not fully accessible via the linear mapping
+		 * FIXME: drop clk_ignore_unused, keeps getting watchdog rebooted without it for now!
 		 */
-		bootargs = "maxcpus=0 initrd=0x45000000,0x1000000";
+		bootargs = "maxcpus=0 initrd=0x45000000,0x1000000 clk_ignore_unused";
 	};
 
-	uart_clk: dummy26m {
-		compatible = "fixed-clock";
-		clock-frequency = <26000000>;
-		#clock-cells = <0>;
-	};
-
-	topckgen: clock-controller@10000000 {
-		compatible = "mediatek,mt6755-topckgen", "mediatek,topckgen";
-		reg = <0x10000000 0x1000>;
-		#clock-cells = <1>;
-	};
-
-	infrasys: clock-controller@10001000 {
-		compatible = "mediatek,mt6755-infrasys";
-		reg = <0x10001000 0x1000>;
-		#clock-cells = <1>;
-	};
-
-	apmixedsys: clock-controller@1000c000 {
-		compatible = "mediatek,mt6755-apmixedsys", "mediatek,apmixed";
-		reg = <0x1000c000 0x1000>, <0x10006000 0x1000>;
-		#clock-cells = <1>;
+	clocks {
+		clk26m: clk26m {
+			compatible = "fixed-clock";
+			clock-frequency = <26000000>;
+			#clock-cells = <0>;
+		};
 	};
 
 	timer {
@@ -130,47 +116,72 @@ timer {
 			     (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
 	};
 
-	sysirq: intpol-controller@10200620 {
-		compatible = "mediatek,mt6755-sysirq",
-			     "mediatek,mt6577-sysirq";
-		interrupt-controller;
-		#interrupt-cells = <3>;
-		interrupt-parent = <&gic>;
-		reg = <0 0x10200620 0 0x20>;
-	};
+	soc {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		compatible = "simple-bus";
+		ranges;
 
-	gic: interrupt-controller@10231000 {
-		compatible = "arm,gic-400";
-		#interrupt-cells = <3>;
-		interrupt-parent = <&gic>;
-		interrupt-controller;
-		reg = <0 0x10231000 0 0x1000>,
-		      <0 0x10232000 0 0x2000>,
-		      <0 0x10234000 0 0x2000>,
-		      <0 0x10236000 0 0x2000>;
-	};
+		topckgen: clock-controller@10000000 {
+			compatible = "mediatek,mt6755-topckgen", "mediatek,topckgen";
+			reg = <0 0x10000000 0 0x1000>;
+			#clock-cells = <1>;
+		};
 
-	watchdog@10007000 {
-		compatible = "mediatek,mt6755-wdt",
-					"mediatek,mt6589-wdt";
-		reg = <0 0x10007000 0 0x100>;
-	};
+		infrasys: clock-controller@10001000 {
+			compatible = "mediatek,mt6755-infrasys";
+			reg = <0 0x10001000 0 0x1000>;
+			#clock-cells = <1>;
+		};
 
-	uart0: serial@11002000 {
-		compatible = "mediatek,mt6755-uart",
-			     "mediatek,mt6577-uart";
-		reg = <0 0x11002000 0 0x400>;
-		interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_LOW>;
-		clocks = <&uart_clk>;
-		status = "disabled";
-	};
+		apmixedsys: clock-controller@1000c000 {
+			compatible = "mediatek,mt6755-apmixedsys", "mediatek,apmixed";
+			reg = <0 0x1000c000 0 0x1000>, <0 0x10006000 0 0x1000>;
+			#clock-cells = <1>;
+		};
+
+		sysirq: intpol-controller@10200620 {
+			compatible = "mediatek,mt6755-sysirq",
+				     	 "mediatek,mt6577-sysirq";
+			interrupt-controller;
+			#interrupt-cells = <3>;
+			interrupt-parent = <&gic>;
+			reg = <0 0x10200620 0 0x20>;
+		};
 
-	uart1: serial@11003000 {
-		compatible = "mediatek,mt6755-uart",
-			     "mediatek,mt6577-uart";
-		reg = <0 0x11003000 0 0x400>;
-		interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_LOW>;
-		clocks = <&uart_clk>;
-		status = "disabled";
+		gic: interrupt-controller@10231000 {
+			compatible = "arm,gic-400";
+			#interrupt-cells = <3>;
+			interrupt-parent = <&gic>;
+			interrupt-controller;
+			reg = <0 0x10231000 0 0x1000>,
+			      <0 0x10232000 0 0x2000>,
+			      <0 0x10234000 0 0x2000>,
+			      <0 0x10236000 0 0x2000>;
+		};
+
+		watchdog@10007000 {
+			compatible = "mediatek,mt6755-wdt",
+						 "mediatek,mt6589-wdt";
+			reg = <0 0x10007000 0 0x100>;
+		};
+
+		uart0: serial@11002000 {
+			compatible = "mediatek,mt6755-uart",
+				     "mediatek,mt6577-uart";
+			reg = <0 0x11002000 0 0x400>;
+			interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&clk26m>;
+			status = "disabled";
+		};
+
+		uart1: serial@11003000 {
+			compatible = "mediatek,mt6755-uart",
+				     "mediatek,mt6577-uart";
+			reg = <0 0x11003000 0 0x400>;
+			interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_LOW>;
+			clocks = <&clk26m>;
+			status = "disabled";
+		};
 	};
 };
-- 
