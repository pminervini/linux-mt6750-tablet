From d81393c385a59ab4dc5a4e3d05728db2079067d6 Mon Sep 17 00:00:00 2001
From: Arseniy Velikanov <adomerlee@gmail.com>
Date: Mon, 2 Jan 2023 07:27:17 +0400
Subject: [PATCH] arm64: dts: mediatek: mt6755-nokia-es2: Add reserved-memory
 nodes from downstream

Signed-off-by: Arseniy Velikanov <adomerlee@gmail.com>
---
 .../boot/dts/mediatek/mt6755-nokia-es2.dts    | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
index ff836c50e1de..1382e54232a8 100644
--- a/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6755-nokia-es2.dts
@@ -25,7 +25,37 @@ chosen {
 
 	/* /reserved-memory has to exist even if practically empty or bootloader will be unhappy */
 	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
 		ranges;
+
+		ccci-md1 {
+			no-map;
+			size = <0x00 0xa100000>;
+			alignment = <0x00 0x2000000>;
+			alloc-ranges = <0x00 0x40000000 0x00 0xc0000000>;
+		};
+
+		ccci-share {
+			no-map;
+			size = <0x00 0x600000>;
+			alignment = <0x00 0x4000000>;
+			alloc-ranges = <0x00 0x40000000 0x00 0xc0000000>;
+		};
+
+		spm {
+			no-map;
+			size = <0x00 0x20000>;
+			alignment = <0x00 0x10000>;
+			alloc-ranges = <0x00 0x40000000 0x00 0x60000000>;
+		};
+
+		consys {
+			no-map;
+			size = <0x00 0x100000>;
+			alignment = <0x00 0x200000>;
+			alloc-ranges = <0x00 0x40000000 0x00 0x60000000>;
+		};
 	};
 
 	memory@40000000 {
