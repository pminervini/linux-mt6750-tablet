+		.of_match_table = of_match_clk_mt6755,
+	},
+};
+
+static int __init clk_mt6755_init(void)
+{
+	return platform_driver_register(&clk_mt6755_drv);
+}
+
+arch_initcall(clk_mt6755_init);
