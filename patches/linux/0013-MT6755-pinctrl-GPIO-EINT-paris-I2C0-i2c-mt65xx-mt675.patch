From 67f991e51d7e0a0eccf64cf677f1e8bb57daeaf9 Mon Sep 17 00:00:00 2001
From: Pasquale Minervini <p.minervini@gmail.com>
Date: Sun, 8 Nov 2026 01:25:08 +0000
Subject: [PATCH 13/31] MT6755: pinctrl (GPIO+EINT, paris), I2C0 (i2c-mt65xx
 mt6755 variant keeping boot TIMING/HS bits), Goodix touch node, VLDO28 on

- pinctrl-mt6755: 190 GPIOs, EINT 0..159 = GPIO n; MODE is 10 pins/register in two
  16-bit halves of 3-bit fields (verified on MSDC0/UART0/I2C0 pins); no pull/drive yet
- i2c-mt65xx: mediatek,mt6755-i2c = mt8173 + keep the bootloader's TIMING[14:12]/HS bits
- dts: gpio controller (label 'gpio': 'pio'/'i2c0' belong to the lk overlay sink),
  i2c@11007000 (13.6 MHz source), goodix@5d (INT GPIO1, RST GPIO10)
- WIP: nothing ACKs on I2C0/I2C1 under mainline yet (controller and GPIO bit-bang)
---
 .../boot/dts/mediatek/mt6750-k50v1-tablet.dts |   50 +
 drivers/i2c/busses/i2c-mt65xx.c               |   37 +-
 drivers/pinctrl/mediatek/Kconfig              |    7 +
 drivers/pinctrl/mediatek/Makefile             |    1 +
 drivers/pinctrl/mediatek/pinctrl-mt6755.c     | 2603 +++++++++++++++++
 drivers/soc/mediatek/mt6755-pmic.c            |    2 +
 6 files changed, 2698 insertions(+), 2 deletions(-)
 create mode 100644 drivers/pinctrl/mediatek/pinctrl-mt6755.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
index 60e97e07f..9d0972b94 100644
--- a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
@@ -14,6 +14,7 @@
 
 #include "mt6755.dtsi"
 #include <dt-bindings/phy/phy.h>
+#include <dt-bindings/gpio/gpio.h>
 
 / {
 	model = "MT6750 tablet k50v1";
@@ -294,6 +295,55 @@ ssusb: usb@11271000 {
 		ranges;
 	};
 
+	/* GPIO + EINT (stock: GPIO 0x10005000, eintc 0x1000b000 SPI 155) */
+	gpio: pinctrl@10005000 {   /* not "pio": that label belongs to the lk overlay sink */
+		compatible = "mediatek,mt6755-pinctrl";
+		reg = <0 0x10005000 0 0x1000>, <0 0x1000b000 0 0x1000>;
+		reg-names = "iocfg0", "eint";
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&gpio 0 0 190>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	/*
+	 * I2C source: stock says 136 MHz with a "divider 10" (13.6 MHz), but with
+	 * clock-div 10 nothing ACKed, i.e. the controller likely sees 136 MHz
+	 * undivided. clock-div 1 is the safe choice either way (if the source is
+	 * 13.6 MHz the bus just runs 10x slower).
+	 */
+	i2c_src_clk: i2c-src-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <136000000>;
+	};
+
+	i2c_0: i2c@11007000 {
+		compatible = "mediatek,mt6755-i2c";
+		reg = <0 0x11007000 0 0x1000>, <0 0x11000100 0 0x80>;
+		interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_LOW>;
+		clocks = <&i2c_src_clk>, <&clk26m_ref>;
+		clock-names = "main", "dma";
+		clock-div = <10>;
+		clock-frequency = <100000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 0x3e: LCD bias (NT50358), programmed by lk: leave alone */
+
+		touchscreen@5d {
+			compatible = "goodix,gt911";
+			reg = <0x5d>;
+			interrupts-extended = <&gpio 1 IRQ_TYPE_EDGE_FALLING>;
+			irq-gpios = <&gpio 1 GPIO_ACTIVE_HIGH>;
+			reset-gpios = <&gpio 10 GPIO_ACTIVE_HIGH>;
+			touchscreen-size-x = <800>;
+			touchscreen-size-y = <1280>;
+		};
+	};
+
 	/*
 	 * LCD backlight: DISP_PWM (stock led_mode 5, CUST_BLS_PWM). lk leaves it
 	 * enabled at clk_div 0 / period 1023; with the 26 MHz stand-in clock a
diff --git a/drivers/i2c/busses/i2c-mt65xx.c b/drivers/i2c/busses/i2c-mt65xx.c
index 307925fb7..7d6a094cc 100644
--- a/drivers/i2c/busses/i2c-mt65xx.c
+++ b/drivers/i2c/busses/i2c-mt65xx.c
@@ -269,6 +269,12 @@ struct mtk_i2c_compatible {
 	unsigned char dma_sync: 1;
 	unsigned char ltiming_adjust: 1;
 	unsigned char apdma_sync: 1;
+	/*
+	 * MT6755: keep the TIMING/HS bits outside the divider fields as the
+	 * bootloader left them (stock only rewrites the dividers; TIMING[14:12]
+	 * is the SDA data-read time, which we cannot derive).
+	 */
+	unsigned char keep_boot_timing: 1;
 	unsigned char max_dma_support;
 };
 
@@ -303,6 +309,7 @@ struct mtk_i2c {
 	unsigned int speed_hz;		/* The speed in transfer */
 	enum mtk_trans_op op;
 	u16 timing_reg;
+	u16 boot_timing_keep, boot_hs_keep;	/* keep_boot_timing */
 	u16 high_speed_reg;
 	u16 ltiming_reg;
 	unsigned char auto_restart;
@@ -456,6 +463,20 @@ static const struct mtk_i2c_compatible mt7986_compat = {
 	.max_dma_support = 32,
 };
 
+static const struct mtk_i2c_compatible mt6755_compat = {
+	.regs = mt_i2c_regs_v1,
+	.pmic_i2c = 0,
+	.dcm = 1,
+	.auto_restart = 1,
+	.aux_len_reg = 1,
+	.timing_adjust = 0,
+	.dma_sync = 0,
+	.ltiming_adjust = 0,
+	.apdma_sync = 0,
+	.keep_boot_timing = 1,
+	.max_dma_support = 33,
+};
+
 static const struct mtk_i2c_compatible mt8173_compat = {
 	.regs = mt_i2c_regs_v1,
 	.pmic_i2c = 0,
@@ -531,6 +552,7 @@ static const struct of_device_id mtk_i2c_of_match[] = {
 	{ .compatible = "mediatek,mt7981-i2c", .data = &mt7981_compat },
 	{ .compatible = "mediatek,mt7986-i2c", .data = &mt7986_compat },
 	{ .compatible = "mediatek,mt8168-i2c", .data = &mt8168_compat },
+	{ .compatible = "mediatek,mt6755-i2c", .data = &mt6755_compat },
 	{ .compatible = "mediatek,mt8173-i2c", .data = &mt8173_compat },
 	{ .compatible = "mediatek,mt8183-i2c", .data = &mt8183_compat },
 	{ .compatible = "mediatek,mt8186-i2c", .data = &mt8186_compat },
@@ -589,8 +611,8 @@ static void mtk_i2c_init_hw(struct mtk_i2c *i2c)
 	if (i2c->dev_comp->dcm)
 		mtk_i2c_writew(i2c, I2C_DCM_DISABLE, OFFSET_DCM_EN);
 
-	mtk_i2c_writew(i2c, i2c->timing_reg, OFFSET_TIMING);
-	mtk_i2c_writew(i2c, i2c->high_speed_reg, OFFSET_HS);
+	mtk_i2c_writew(i2c, i2c->timing_reg | i2c->boot_timing_keep, OFFSET_TIMING);
+	mtk_i2c_writew(i2c, i2c->high_speed_reg | i2c->boot_hs_keep, OFFSET_HS);
 	if (i2c->dev_comp->ltiming_adjust)
 		mtk_i2c_writew(i2c, i2c->ltiming_reg, OFFSET_LTIMING);
 
@@ -1407,6 +1429,17 @@ static int mtk_i2c_probe(struct platform_device *pdev)
 	init_completion(&i2c->msg_complete);
 
 	i2c->dev_comp = of_device_get_match_data(&pdev->dev);
+	if (i2c->dev_comp->keep_boot_timing) {
+		u16 t = readw(i2c->base + i2c->dev_comp->regs[OFFSET_TIMING]);
+		u16 h = readw(i2c->base + i2c->dev_comp->regs[OFFSET_HS]);
+
+		/* everything but sample [10:8] / step [5:0]; HS: but enable, dividers */
+		i2c->boot_timing_keep = t & ~0x073f;
+		i2c->boot_hs_keep = h & ~0x7701;
+		dev_info(&pdev->dev, "boot TIMING 0x%04x HS 0x%04x: keeping 0x%04x/0x%04x\n",
+			 t, h, i2c->boot_timing_keep, i2c->boot_hs_keep);
+	}
+
 	i2c->adap.dev.of_node = pdev->dev.of_node;
 	i2c->dev = &pdev->dev;
 	i2c->adap.dev.parent = &pdev->dev;
