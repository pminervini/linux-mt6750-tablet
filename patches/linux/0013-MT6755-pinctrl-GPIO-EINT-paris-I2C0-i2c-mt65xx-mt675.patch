+/*
+ * MediaTek MT6755 (Helio P10 / MT6750) pin controller: GPIO + EINT only.
+ *
+ * GPIO block at 0x10005000: DIR 0x0, DO 0x100, DI 0x200 (1 bit/pin, 32 pins per
+ * register, 0x10 stride as MT6765); MODE 0x300 has its own 3-bit layout (below); EINT at 0x1000b000 uses the generic MediaTek EINT register map
+ * (stock irq-mt-eic: 160 EINTs, EINT n = GPIO n, 16 hw debounce slots).
+ * Pull/drive/IES live in the IOCFG blocks and are not described yet, so pin
+ * configuration other than mux/direction/value is unsupported.
+ * Function names are generic ("GPIOn_Mm"); use numeric pinmux in DT.
+ */
+
+#include <linux/module.h>
+#include "pinctrl-paris.h"
+
+/*
+ * MODE: 10 pins per register, 3-bit fields in two 16-bit halves (bits 0,3,..,12
+ * and 16,19,..,28; bits 15/31 unused) -> one range per 5-pin half. Verified on
+ * live registers: MSDC0 GPIO178-180, UART0 GPIO105/106, I2C0 GPIO92/93 = mode 1.
+ */
