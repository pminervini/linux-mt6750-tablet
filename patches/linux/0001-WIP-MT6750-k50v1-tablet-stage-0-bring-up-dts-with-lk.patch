diff --git a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
new file mode 100644
index 000000000..4f5522e23
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * No-name MT6750 tablet ("Pad_6s_Pro", board k50v1_64), stage 0 bring-up.
+ *
+ * Bootloader (MTK lk) quirks, from the live DT of the stock kernel:
+ *  - lk patches /memory, /chosen (initrd, bootargs, atags) and adds
+ *    dynamically placed mblock-* children to /reserved-memory, so both
+ *    nodes must exist with #address-cells/#size-cells = 2.
+ *  - "bootopt=64S3,32N2,64N2" must be on the boot.img cmdline for a 64-bit
+ *    kernel; the real cmdline is CONFIG_CMDLINE (forced).
+ */
+
+/dts-v1/;
+
+#include "mt6755.dtsi"
+
+/ {
+	model = "MT6750 tablet k50v1";
+	compatible = "mediatek,k50v1-tablet", "mediatek,mt6755";
+
+	/* ATF of this era: PSCI 0.1 with explicit function IDs (as stock) */
+	psci {
+		compatible = "arm,psci";
+		method = "smc";
+		cpu_suspend = <0x84000001>;
+		cpu_off = <0x84000002>;
+		cpu_on = <0x84000003>;
+	};
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen: chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* must exist, lk rewrites it */
+		bootargs = "";
+		stdout-path = &framebuffer0;
+
+		/* Display left running by lk; base/size from atag,videolfb (800x1280, 32bpp) */
+		framebuffer0: framebuffer@7f190000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x7f190000 0x0 0x3e8000>;
+			width = <800>;
+			height = <1280>;
+			stride = <(800 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		/* lk overwrites this with the real size (2 GiB) */
+		reg = <0x0 0x40000000 0x0 0x80000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* MTK ram_console (SRAM/DRAM boot log of preloader/lk) */
+		ram_console@44400000 {
+			reg = <0x0 0x44400000 0x0 0x10000>;
+			no-map;
+		};
+
+		/*
+		 * Inside the stock pstore region (which survives the BROM/DA readback);
+		 * the upper part is the bring-up entry marker + RAM console.
+		 */
+		ramoops@44410000 {
+			compatible = "ramoops";
+			reg = <0x0 0x44410000 0x0 0x70000>;
+			record-size = <0x1000>;
+			console-size = <0x40000>;
+			ftrace-size = <0x1000>;
+			pmsg-size = <0x10000>;
+		};
+
+		bringup-ramcon@44480000 {
+			reg = <0x0 0x44480000 0x0 0x20000>;
+			no-map;
+		};
+
+		minirdump@444f0000 {
+			reg = <0x0 0x444f0000 0x0 0x10000>;
+			no-map;
+		};
+
+		atf@44600000 {
+			reg = <0x0 0x44600000 0x0 0x40000>;
+			no-map;
+		};
+
+		preloader@44800000 {
+			reg = <0x0 0x44800000 0x0 0x100000>;
+			no-map;
+		};
+
+		lk@46000000 {
+			reg = <0x0 0x46000000 0x0 0x400000>;
+			no-map;
+		};
+
+		framebuffer@7f190000 {
+			reg = <0x0 0x7f190000 0x0 0xdb0000>;
+			no-map;
+		};
+
+		atf-log@7ff40000 {
+			reg = <0x0 0x7ff40000 0x0 0x40000>;
+			no-map;
+		};
+
+		log-store@7ff80000 {
+			reg = <0x0 0x7ff80000 0x0 0x80000>;
+			no-map;
+		};
+
+		/* modem / ccci, consys, spm placed by lk on the stock boot */
+		ccci@8e000000 {
+			reg = <0x0 0x8e000000 0x0 0xa000000>;
+			no-map;
+		};
+
+		ccci-share@98000000 {
+			reg = <0x0 0x98000000 0x0 0x20000>;
+			no-map;
+		};
+
+		consys@9fe00000 {
+			reg = <0x0 0x9fe00000 0x0 0x100000>;
+			no-map;
+		};
+
+		spm@9ffe0000 {
+			reg = <0x0 0x9ffe0000 0x0 0x20000>;
+			no-map;
+		};
+	};
+
+
+	/*
+	 * lk unconditionally applies the ODM overlay from the "odmdtbo"
+	 * partition (stock 3.18 DT fragments) and ASSERTs if any target label
+	 * is missing (needs __symbols__, i.e. dtc -@). Give every target a
+	 * parking node without "compatible" so nothing probes from it.
+	 */
+	lk-overlay-sink {
+		lcm: lcm { status = "disabled"; };
+		pio: pio { status = "disabled"; };
+		odm: odm { status = "disabled"; };
+		accdet: accdet { status = "disabled"; };
+		touch: touch { status = "disabled"; };
+		kd_camera_hw1: kd-camera-hw1 { status = "disabled"; };
+		mtkfb: mtkfb { status = "disabled"; };
+		consys: consys { status = "disabled"; };
+		sleep: sleep { status = "disabled"; };
+		audgpio: audgpio { status = "disabled"; };
+		apuart0: apuart0 { status = "disabled"; };
+		irtx_pwm: irtx-pwm { status = "disabled"; };
+		speaker_gpio: speaker-gpio { status = "disabled"; };
+		nfc: nfc { status = "disabled"; };
+		usb0: usb0 { status = "disabled"; };
+		xhci0: xhci0 { status = "disabled"; };
+		i2c1: i2c1 { status = "disabled"; };
+		ext_buck_vmd1: ext-buck-vmd1 { status = "disabled"; };
+		hall: hall { status = "disabled"; };
+		i2c0: i2c0 { status = "disabled"; };
+		i2c2: i2c2 { status = "disabled"; };
+		i2c3: i2c3 { status = "disabled"; };
+		i2c4: i2c4 { status = "disabled"; };
+		eintc: eintc { status = "disabled"; };
+		msdc1_ins: msdc1-ins { status = "disabled"; };
+		otg_iddig_1: otg-iddig-1 { status = "disabled"; };
+		dsi_te: dsi-te { status = "disabled"; };
+		gpio_usage_mapping: gpio-usage-mapping { status = "disabled"; };
+		mt_pmic_vcama_ldo_reg: mt-pmic-vcama-ldo-reg { status = "disabled"; };
+		mt_pmic_vsim1_ldo_reg: mt-pmic-vsim1-ldo-reg { status = "disabled"; };
+		mt_pmic_vsim2_ldo_reg: mt-pmic-vsim2-ldo-reg { status = "disabled"; };
+		mt_pmic_vldo28_ldo_reg: mt-pmic-vldo28-ldo-reg { status = "disabled"; };
+		mt_pmic_vibr_ldo_reg: mt-pmic-vibr-ldo-reg { status = "disabled"; };
+		mt_pmic_vcamd_ldo_reg: mt-pmic-vcamd-ldo-reg { status = "disabled"; };
+		mt_pmic_vcamio_ldo_reg: mt-pmic-vcamio-ldo-reg { status = "disabled"; };
+		auxadc: auxadc { status = "disabled"; };
+		rf_clock_buffer_ctrl: rf-clock-buffer-ctrl { status = "disabled"; };
+		pmic_clock_buffer_ctrl: pmic-clock-buffer-ctrl { status = "disabled"; };
+		keypad: keypad { status = "disabled"; };
+	};
+
+	watchdog@10007000 {
+		compatible = "mediatek,mt6589-wdt";
+		/* stock reboot = AUTO_RESTART|EXTEN, else the preloader powers off */
+		mediatek,restart-bypass-pwrkey;
+		reg = <0 0x10007000 0 0x100>;
+	};
+};
+
+&{/timer} {
+	/* CNTFRQ is not reliably programmed by this firmware (stock DT sets it) */
+	clock-frequency = <13000000>;
+};
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 87a822e5c..8549ccac3 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -83,6 +83,30 @@
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
 SYM_CODE_START(primary_entry)
+#ifdef CONFIG_SERIAL_EARLYCON_RAM_FORCE
+	/* bring-up: prove we were entered; store magic, CurrentEL, SCTLR, x0-x3 */
+	movz	x9, #(CONFIG_SERIAL_EARLYCON_RAM_HEAD & 0xffff)
+	movk	x9, #((CONFIG_SERIAL_EARLYCON_RAM_HEAD >> 16) & 0xffff), lsl #16
+	movz	x10, #0x4548
+	movk	x10, #0x4441, lsl #16		/* "HEAD" */
+	mrs	x11, CurrentEL
+	stp	x10, x11, [x9]
+	stp	x0, x1, [x9, #16]
+	stp	x2, x3, [x9, #32]
+	adr	x10, primary_entry
+	str	x10, [x9, #48]
+	cmp	x11, #CurrentEL_EL2
+	b.ne	1f
+	mrs	x10, sctlr_el2
+	b	2f
+1:	mrs	x10, sctlr_el1
+2:	str	x10, [x9, #56]
+	dsb	sy
+	dc	civac, x9
+	add	x10, x9, #32
+	dc	civac, x10
+	dsb	sy
+#endif
 	bl	record_mmu_state
 	bl	preserve_boot_args
 
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 29c6100f0..9d74db34a 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -288,6 +288,13 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 
 	early_fixmap_init();
 	early_ioremap_init();
+#ifdef CONFIG_SERIAL_EARLYCON_RAM_FORCE
+	{
+		extern void __init ramcon_force(phys_addr_t base, unsigned long size,
+						u64 fdt, const u64 *args);
+		ramcon_force(CONFIG_SERIAL_EARLYCON_RAM_BASE, SZ_64K, __fdt_pointer, boot_args);
+	}
+#endif
 
 	setup_machine_fdt(__fdt_pointer);
 
diff --git a/drivers/tty/serial/Kconfig b/drivers/tty/serial/Kconfig
index cf7dba473..1bffa8e60 100644
--- a/drivers/tty/serial/Kconfig
+++ b/drivers/tty/serial/Kconfig
@@ -73,6 +73,20 @@ config SERIAL_AMBA_PL011_CONSOLE
 	  your boot loader (lilo or loadlin) about how to pass options to the
 	  kernel at boot time.)
 
+config SERIAL_EARLYCON_RAM_FORCE
+	bool "Force RAM console from the start of setup_arch (bring-up hack)"
+	depends on ARM64 && SERIAL_EARLYCON
+
+config SERIAL_EARLYCON_RAM_BASE
+	hex "Physical base of the forced RAM console (64K)"
+	depends on SERIAL_EARLYCON_RAM_FORCE
+	default 0x44490000
+
+config SERIAL_EARLYCON_RAM_HEAD
+	hex "Physical address of the kernel-entry marker (64 bytes)"
+	depends on SERIAL_EARLYCON_RAM_FORCE
+	default 0x44480000
+
 config SERIAL_EARLYCON_SEMIHOST
 	bool "Early console using Arm compatible semihosting"
 	depends on ARM64 || ARM || RISCV
