diff --git a/drivers/tty/serial/earlycon-ram.c b/drivers/tty/serial/earlycon-ram.c
new file mode 100644
index 000000000..5c3dfe0e0
--- /dev/null
+++ b/drivers/tty/serial/earlycon-ram.c
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * "ramcon" earlycon: writes the kernel log into a DRAM buffer mapped as
+ * device (uncached) memory, so it survives a watchdog reset that drops
+ * dirty cache lines. For bring-up of boards without a reachable UART;
+ * read it back from the boot ROM / DA (e.g. mtkclient "da peek").
+ *
+ *   earlycon=ramcon,<phys>[,<size>]   (size defaults to 64K)
+ *
+ * Layout: u32 magic 'RCON', u32 write offset (into data), u32 data size,
+ * u32 wrap count, then data (ring buffer).
+ */
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/serial_core.h>
+#include <linux/string.h>
+#include <asm/early_ioremap.h>
+
+#define RAMCON_MAGIC	0x4e4f4352	/* "RCON" */
+#define RAMCON_HDR	16
+
+static void __iomem *ramcon_base;
+static phys_addr_t ramcon_phys;
+static u32 ramcon_size, ramcon_pos, ramcon_wraps;
+static bool ramcon_forced;
+
+static void ramcon_write(struct console *con, const char *s, unsigned int n)
+{
+	void __iomem *base = READ_ONCE(ramcon_base);
+
+	if (!base)
+		return;
+	while (n--) {
+		writeb_relaxed(*s++, base + RAMCON_HDR + ramcon_pos);
+		if (++ramcon_pos >= ramcon_size) {
+			ramcon_pos = 0;
+			ramcon_wraps++;
+			writel_relaxed(ramcon_wraps, base + 12);
+		}
+	}
+	writel(ramcon_pos, base + 4);
+}
+
+static int __init ramcon_setup(struct earlycon_device *dev, const char *opt)
+{
+	unsigned long size = SZ_64K;
+	char *p;
+
+	ramcon_phys = dev->port.mapbase;
+	if (!ramcon_phys)
+		return -ENODEV;
+	/* option after the address: "<size>" (lands in dev->options) */
+	if (dev->options[0]) {
+		size = simple_strtoul(dev->options, &p, 0);
+		if (size < SZ_4K)
+			size = SZ_64K;
+	}
+	ramcon_size = size - RAMCON_HDR;
+	ramcon_base = early_ioremap(ramcon_phys, size);
+	if (!ramcon_base)
+		return -ENOMEM;
+	ramcon_pos = 0;
+	ramcon_wraps = 0;
+	writel_relaxed(RAMCON_MAGIC, ramcon_base);
+	writel_relaxed(0, ramcon_base + 4);
+	writel_relaxed(ramcon_size, ramcon_base + 8);
+	writel_relaxed(0, ramcon_base + 12);
+	dev->con->write = ramcon_write;
+	return 0;
+}
+EARLYCON_DECLARE(ramcon, ramcon_setup);
+
+static struct console ramcon_console = {
+	.name	= "ramcon",
+	.write	= ramcon_write,
+	.flags	= CON_PRINTBUFFER | CON_BOOT | CON_ANYTIME,
+	.index	= -1,
+};
+
+/*
+ * Forced variant, called from setup_arch() before the FDT is parsed.
+ * Extra header words after the ring header (offsets 16..63 of the region,
+ * ring data then starts at 64): fdt pointer, boot_args[0..3], marker.
+ */
+void __init ramcon_force(phys_addr_t base, unsigned long size, u64 fdt, const u64 *args)
+{
+	void __iomem *b = early_ioremap(base, size);
+	int i;
+
+	if (!b)
+		return;
+	writeq_relaxed(0x2152454b52414d4dULL, b + 16);	/* "MMARKER!" */
+	writeq_relaxed(fdt, b + 24);
+	for (i = 0; i < 4; i++)
+		writeq_relaxed(args[i], b + 32 + 8 * i);
+	ramcon_phys = base + 64;
+	ramcon_size = size - 64 - RAMCON_HDR;
+	ramcon_base = b + 64;
+	ramcon_pos = 0;
+	ramcon_wraps = 0;
+	writel_relaxed(RAMCON_MAGIC, b);
+	writel_relaxed(ramcon_size, b + 8);
+	/* ring header lives at b+64 as well, keep both views consistent */
+	writel_relaxed(RAMCON_MAGIC, ramcon_base);
+	writel_relaxed(0, ramcon_base + 4);
+	writel_relaxed(ramcon_size, ramcon_base + 8);
+	writel_relaxed(0, ramcon_base + 12);
+	ramcon_forced = true;
+	register_console(&ramcon_console);
+
+#ifdef CONFIG_ARCH_MEDIATEK
+	/*
+	 * Bring-up: MT6755 preloader powers off after a watchdog reset unless
+	 * AUTO_RESTART ("bypass power key") is set in TOPRGU WDT_MODE. Set it
+	 * (plus EXTEN) right away so a hang that ends in a WDT timeout comes
+	 * back as a reboot instead of a power-off. Keeps EN/timeout as lk set.
+	 */
+	{
+		void __iomem *wdt = early_ioremap(0x10007000, 0x100);
+
+		if (wdt) {
+			u32 mode = readl(wdt);
+
+			writel((mode & 0xff) | 0x14 | 0x22000000, wdt);
+			writel_relaxed(mode, b + 4);
+			writel_relaxed(readl(wdt), b + 12);
+			early_iounmap(wdt, 0x100);
+		}
+	}
+#endif
+	pr_info("ramcon: forced at %pa, fdt=%llx x1..x3=%llx %llx %llx\n",
+		&base, fdt, args[1], args[2], args[3]);
+}
+
+/* swap the early_ioremap slot for a permanent device mapping */
+static int __init ramcon_remap(void)
+{
+	void __iomem *early = ramcon_base, *late;
+
+	if (!early)
+		return 0;
+	late = ioremap(ramcon_phys, ramcon_size + RAMCON_HDR);
+	if (!late)
+		return 0;
+	WRITE_ONCE(ramcon_base, late);
+	if (!ramcon_forced)
+		early_iounmap(early, ramcon_size + RAMCON_HDR);
+	pr_info("ramcon: log at %pa (+%u)\n", &ramcon_phys, ramcon_size);
+	return 0;
+}
+early_initcall(ramcon_remap);
diff --git a/drivers/watchdog/mtk_wdt.c b/drivers/watchdog/mtk_wdt.c
index d9c30e4c8..16020bd67 100644
--- a/drivers/watchdog/mtk_wdt.c
+++ b/drivers/watchdog/mtk_wdt.c
@@ -75,6 +75,7 @@ struct mtk_wdt_dev {
 	spinlock_t lock; /* protects WDT_SWSYSRST reg */
 	struct reset_controller_dev rcdev;
 	bool disable_wdt_extrst;
+	bool restart_bypass_pwrkey;
 	bool reset_by_toprgu;
 	bool has_swsysrst_en;
 };
@@ -237,7 +238,17 @@ static int mtk_wdt_restart(struct watchdog_device *wdt_dev,
 	/* Enable reset in order to issue a system reset instead of an IRQ */
 	reg = readl(wdt_base + WDT_MODE);
 	reg &= ~WDT_MODE_IRQ_EN;
+	if (mtk_wdt->restart_bypass_pwrkey) {
+		/*
+		 * Older MediaTek preloaders (e.g. MT6755) treat AUTO_START as
+		 * "bypass power key": without it a SW reset ends in power-off.
+		 * Mirror the vendor kernel's wdt_arch_reset(1).
+		 */
+		reg &= ~(WDT_MODE_EN | WDT_MODE_DUAL_EN);
+		reg |= WDT_MODE_AUTO_START | WDT_MODE_EXRST_EN;
+	}
 	writel(reg | WDT_MODE_KEY, wdt_base + WDT_MODE);
+	udelay(100);
 
 	while (1) {
 		writel(WDT_SWRST_KEY, wdt_base + WDT_SWRST);
@@ -462,6 +473,8 @@ static int mtk_wdt_probe(struct platform_device *pdev)
 
 	mtk_wdt->disable_wdt_extrst =
 		of_property_read_bool(dev->of_node, "mediatek,disable-extrst");
+	mtk_wdt->restart_bypass_pwrkey =
+		of_property_read_bool(dev->of_node, "mediatek,restart-bypass-pwrkey");
 
 	mtk_wdt->reset_by_toprgu =
 		of_property_read_bool(dev->of_node, "mediatek,reset-by-toprgu");
-- 
