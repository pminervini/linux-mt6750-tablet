From 50c51448f8178acd8bc8834961e9a9b4c201f65b Mon Sep 17 00:00:00 2001
From: Pasquale Minervini <p.minervini@gmail.com>
Date: Sat, 7 Nov 2026 22:11:58 +0000
Subject: [PATCH 08/29] soc: mediatek: mt6755-pmic: MT6353 pwrap accessors,
 pulse charger, AUXADC battery readout; dts: CONSYS/BTIF/WiFi nodes

- mt6755_pmic_read/write/rmw (WACS2, mutex-serialized), exported for the connsys modules
- charger: CHR_EN + 2 s WDT kick, CS_VTH 450 mA; sysfs /sys/kernel/mt6755_pmic
- dts: consys reserved memory (1 MB), btif/apdma, consys@18070000, wifi@180f0000
---
 .../boot/dts/mediatek/mt6750-k50v1-tablet.dts |  52 +++
 drivers/soc/mediatek/Makefile                 |   2 +-
 drivers/soc/mediatek/mt6755-pmic.c            | 308 ++++++++++++++++++
 3 files changed, 361 insertions(+), 1 deletion(-)
 create mode 100644 drivers/soc/mediatek/mt6755-pmic.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
index cae08698a..910ccb2da 100644
--- a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
@@ -110,6 +110,15 @@ lk@46000000 {
 			no-map;
 		};
 
+		/* CONSYS (WiFi/BT/GPS) shared memory, dynamically placed as in stock */
+		consys_mem: consys-reserve-memory {
+			compatible = "mediatek,consys-reserve-memory";
+			no-map;
+			size = <0 0x100000>;
+			alignment = <0 0x200000>;
+			alloc-ranges = <0 0x40000000 0 0x60000000>;
+		};
+
 
 
 
@@ -285,6 +294,49 @@ ssusb: usb@11271000 {
 		ranges;
 	};
 
+	/*
+	 * Connectivity (out-of-tree modules in mainline/connsys): BTIF + APDMA
+	 * channels, CONSYS (WMT), WiFi AHB window. Clock gates are on from boot
+	 * (INFRA_BTIF / INFRA_AP_DMA), so a fixed clock stands in for them.
+	 */
+	btif@1100c000 {
+		compatible = "mediatek,btif";
+		reg = <0 0x1100c000 0 0x1000>;
+		interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_LOW>;
+		clocks = <&clk26m_ref>, <&clk26m_ref>;
+		clock-names = "btifc", "apdmac";
+	};
+
+	btif_tx@11000780 {
+		compatible = "mediatek,btif_tx";
+		reg = <0 0x11000780 0 0x80>;
+		interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_LOW>;
+	};
+
+	btif_rx@11000800 {
+		compatible = "mediatek,btif_rx";
+		reg = <0 0x11000800 0 0x80>;
+		interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_LOW>;
+	};
+
+	consys@18070000 {
+		compatible = "mediatek,mt6755-consys";
+		/* CONN MCU cfg, TOPRGU, TOPCKGEN+INFRACFG_AO, SPM */
+		reg = <0 0x18070000 0 0x200>, <0 0x10007000 0 0x100>,
+		      <0 0x10000000 0 0x2000>, <0 0x10006000 0 0x1000>;
+		interrupts = <GIC_SPI 237 IRQ_TYPE_LEVEL_LOW>,	/* BGF wakeup */
+			     <GIC_SPI 239 IRQ_TYPE_LEVEL_LOW>;	/* CONN WDT */
+		memory-region = <&consys_mem>;
+	};
+
+	wifi@180f0000 {
+		compatible = "mediatek,wifi";
+		reg = <0 0x180f0000 0 0x5c>;
+		interrupts = <GIC_SPI 238 IRQ_TYPE_LEVEL_LOW>;
+		clocks = <&clk26m_ref>;
+		clock-names = "wifi-dma";
+	};
+
 	watchdog@10007000 {
 		compatible = "mediatek,mt6589-wdt";
 		/* stock reboot = AUTO_RESTART|EXTEN, else the preloader powers off */
diff --git a/drivers/soc/mediatek/Makefile b/drivers/soc/mediatek/Makefile
index bb1fbb3d1..dc260551e 100644
--- a/drivers/soc/mediatek/Makefile
+++ b/drivers/soc/mediatek/Makefile
@@ -9,4 +9,4 @@ obj-$(CONFIG_MTK_MMSYS) += mtk-mmsys.o
 obj-$(CONFIG_MTK_MMSYS) += mtk-mutex.o
 obj-$(CONFIG_MTK_SVS) += mtk-svs.o
