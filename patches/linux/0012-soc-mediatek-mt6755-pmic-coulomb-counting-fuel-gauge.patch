@@ -554,13 +693,20 @@ static int bat_get(struct power_supply *psy, enum power_supply_property psp,
 		val->intval = bs.vbat * 1000;
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
-		val->intval = bs.ibat * 1000;
+		val->intval = bs.fg_ma * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		val->intval = (int)div_s64(bs.q_nah, 1000);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = qmax_mah * 1000;
 		break;
 	case POWER_SUPPLY_PROP_TEMP:
 		val->intval = bs.temp;
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY:
-		val->intval = bs.cap16 / 16;
+		val->intval = bs.cap;
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
 		val->intval = 4200000;
