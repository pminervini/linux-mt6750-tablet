diff --git a/drivers/soc/mediatek/mt6755-bringup.c b/drivers/soc/mediatek/mt6755-bringup.c
new file mode 100644
index 000000000..87263352b
--- /dev/null
+++ b/drivers/soc/mediatek/mt6755-bringup.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6755/MT6750 bring-up helper (until a real clock driver is wired up):
+ * ungate the clocks the boot loader leaves off but our fixed-clock DT
+ * nodes assume running. Values from the stock kernel's clk_summary and the
+ * MT6755 clock tables (topckgen CLK_CFG_7, infracfg PDN2).
+ */
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/iopoll.h>
+#include <linux/spinlock.h>
+#include <asm/cputype.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+
+#define TOPCKGEN		0x10000000
+#define  CLK_CFG_UPDATE		0x004
+#define  CLK_CFG_7		0x0b0
+#define  CLK_CFG_7_SET		0x0b4
+#define  CLK_CFG_7_CLR		0x0b8
+#define INFRACFG		0x10001000
+#define  INFRA_PDN_CLR2		0x0a8
+#define  INFRA_PDN_STA2		0x0ac
+
+static int __init mt6755_bringup_clocks(void)
+{
+	void __iomem *top, *infra;
+
+	if (!of_machine_is_compatible("mediatek,k50v1-tablet"))
+		return 0;
+	top = ioremap(TOPCKGEN, 0x1000);
+	infra = ioremap(INFRACFG, 0x1000);
+	if (!top || !infra)
+		return -ENOMEM;
+
+	pr_info("mt6755-bringup: before CLK_CFG_7=%08x INFRA_PDN_STA2=%08x\n",
+		readl(top + CLK_CFG_7), readl(infra + INFRA_PDN_STA2));
+	/* ssusb_top_sys_sel: parent univpll3_d2 (124.8 MHz, bit 8), ungate (pdn bit 15) */
+	writel(BIT(8), top + CLK_CFG_7_SET);
+	writel(BIT(15), top + CLK_CFG_7_CLR);
+	writel(BIT(28), top + CLK_CFG_UPDATE);
+	/* infra_ssusbtop (PDN2 bit 1) */
+	writel(BIT(1), infra + INFRA_PDN_CLR2);
+	pr_info("mt6755-bringup: after  CLK_CFG_7=%08x INFRA_PDN_STA2=%08x\n",
+		readl(top + CLK_CFG_7), readl(infra + INFRA_PDN_STA2));
+	iounmap(top);
+	iounmap(infra);
+	return 0;
+}
+arch_initcall(mt6755_bringup_clocks);
+
+/*
+ * Secondary CPU power-up through the SPM (stock mt_spm_mtcmos.c
+ * spm_mtcmos_ctrl_cpuN, STA_POWER_ON). Only cluster 0 (MP0) for now: MP1
+ * cores power up but never reach the kernel entry (cluster coherency /
+ * ATF state still missing), so they are refused before PSCI CPU_ON.
+ */
+#define SPM_BASE		0x10006000
+#define  SPM_POWERON_CONFIG_EN	0x000
+#define  SPM_PROJECT_CODE	0xb16
+#define  SPM_PWR_STATUS		0x180
+#define  SPM_PWR_STATUS_2ND	0x184
+#define  SPM_MP0_CPUTOP_PWR_CON	0x204
+#define  SPM_MP0_CPU_PWR_CON(n)	(0x208 + 4 * (n))
+#define  SPM_MP0_CPU_L1_PDN(n)	(0x248 + 4 * (n))
+#define  MP0_CPUTOP_STA		BIT(8)
+#define  MP0_CPU_STA(n)		BIT(9 + (n))
+#define PWR_RST_B		BIT(0)
+#define PWR_ISO			BIT(1)
+#define PWR_ON			BIT(2)
+#define PWR_ON_2ND		BIT(3)
+#define PWR_CLK_DIS		BIT(4)
+#define SRAM_CKISO		BIT(5)
+#define SRAM_ISOINT_B		BIT(6)
+#define L1_SRAM_PDN		BIT(0)
+#define L1_SRAM_PDN_ACK		BIT(8)
+
+static void __iomem *spm;
+static DEFINE_RAW_SPINLOCK(spm_cpu_lock);
+
+static bool mt6755_spm_cpu_ok(void)
+{
+	if (!of_machine_is_compatible("mediatek,k50v1-tablet"))
+		return false;
+	if (!spm)
+		spm = ioremap(SPM_BASE, 0x1000);
+	return spm;
+}
+
+int mtk_spm_cpu_can_boot(u64 mpidr)
+{
+	if (!mt6755_spm_cpu_ok())
+		return 0;
+	if (MPIDR_AFFINITY_LEVEL(mpidr, 1) != 0)
+		return -EOPNOTSUPP;
+	if (!(readl(spm + SPM_PWR_STATUS) & MP0_CPUTOP_STA))
+		return -ENODEV;
+	return 0;
+}
+
+static void spm_rmw(u32 off, u32 clr, u32 set)
+{
+	writel((readl(spm + off) & ~clr) | set, spm + off);
+}
+
+int mtk_spm_cpu_power_on(u64 mpidr)
+{
+	unsigned int n = MPIDR_AFFINITY_LEVEL(mpidr, 0);
+	u32 con = SPM_MP0_CPU_PWR_CON(n), pdn = SPM_MP0_CPU_L1_PDN(n), v;
+	unsigned long flags;
+	int ret;
+
+	if (!mt6755_spm_cpu_ok() || MPIDR_AFFINITY_LEVEL(mpidr, 1) != 0 || n > 3)
+		return 0;
+	if (readl(spm + SPM_PWR_STATUS) & MP0_CPU_STA(n))
+		return 0;	/* already powered */
+
+	raw_spin_lock_irqsave(&spm_cpu_lock, flags);
+	writel((SPM_PROJECT_CODE << 16) | BIT(0), spm + SPM_POWERON_CONFIG_EN);
+	spm_rmw(con, 0, PWR_ON);
+	spm_rmw(con, 0, PWR_ON_2ND);
+	ret = readl_poll_timeout_atomic(spm + SPM_PWR_STATUS, v, v & MP0_CPU_STA(n), 1, 1000);
+	if (!ret)
+		ret = readl_poll_timeout_atomic(spm + SPM_PWR_STATUS_2ND, v,
+						v & MP0_CPU_STA(n), 1, 1000);
+	if (!ret) {
+		spm_rmw(con, PWR_ISO, 0);
+		spm_rmw(pdn, L1_SRAM_PDN, 0);
+		ret = readl_poll_timeout_atomic(spm + pdn, v, !(v & L1_SRAM_PDN_ACK), 1, 1000);
+	}
+	if (!ret) {
+		udelay(1);
+		spm_rmw(con, 0, SRAM_ISOINT_B);
+		spm_rmw(con, SRAM_CKISO, 0);
+		spm_rmw(con, PWR_CLK_DIS, 0);
+		spm_rmw(con, 0, PWR_RST_B);
+	}
+	raw_spin_unlock_irqrestore(&spm_cpu_lock, flags);
+	if (ret)
+		pr_err("mt6755-bringup: SPM power-on of CPU%u timed out (con=%08x)\n",
+		       n, readl(spm + con));
+	return ret;
+}
