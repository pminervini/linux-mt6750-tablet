-			pinctrl_select_state(host->pinctrl, host->pins_eint);
+			msdc_pin_select(host, host->pins_eint);
 			ret = dev_pm_set_dedicated_wake_irq_reverse(host->dev, host->eint_irq);
 
 			if (ret) {
@@ -1764,7 +1770,7 @@ static void msdc_enable_sdio_irq(struct mmc_host *mmc, int enb)
 				dev_dbg(host->dev, "SDIO eint irq: %d!\n", host->eint_irq);
 			}
 
-			pinctrl_select_state(host->pinctrl, host->pins_uhs);
+			msdc_pin_select(host, host->pins_uhs);
 		} else {
 			dev_pm_clear_wake_irq(host->dev);
 		}
@@ -3039,10 +3045,17 @@ static int msdc_drv_probe(struct platform_device *pdev)
 		return host->irq;
 
 	host->pinctrl = devm_pinctrl_get(&pdev->dev);
-	if (IS_ERR(host->pinctrl))
+	if (PTR_ERR_OR_ZERO(host->pinctrl) == -ENODEV &&
+	    of_property_read_bool(pdev->dev.of_node, "mediatek,pins-preset")) {
