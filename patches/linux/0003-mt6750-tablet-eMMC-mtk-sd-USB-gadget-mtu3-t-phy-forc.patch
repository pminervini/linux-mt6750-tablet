From 4881d9c715033eef5943c2265b53ccc1e31210ab Mon Sep 17 00:00:00 2001
From: Pasquale Minervini <p.minervini@gmail.com>
Date: Sat, 7 Nov 2026 09:09:00 +0000
Subject: [PATCH 03/32] mt6750 tablet: eMMC (mtk-sd), USB gadget (mtu3 + t-phy
 force-vbus, PHY at 0x11290000), SPM CPU power-on for cluster 0

---
 .../boot/dts/mediatek/mt6750-k50v1-tablet.dts | 131 +++++++++++++++-
 arch/arm64/kernel/head.S                      |   9 ++
 arch/arm64/kernel/psci.c                      |  17 ++-
 drivers/mmc/host/mtk-sd.c                     |  28 +++-
 drivers/phy/mediatek/phy-mtk-tphy.c           |  17 +++
 drivers/soc/mediatek/Makefile                 |   1 +
 drivers/soc/mediatek/mt6755-bringup.c         | 144 ++++++++++++++++++
 drivers/tty/serial/Kconfig                    |   4 +-
 drivers/usb/mtu3/mtu3_plat.c                  |   3 +
 drivers/watchdog/mtk_wdt.c                    |   2 +
 10 files changed, 341 insertions(+), 15 deletions(-)
 create mode 100644 drivers/soc/mediatek/mt6755-bringup.c

diff --git a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
index 3dabc3660..cae08698a 100644
--- a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
@@ -13,6 +13,7 @@
 /dts-v1/;
 
 #include "mt6755.dtsi"
+#include <dt-bindings/phy/phy.h>
 
 / {
 	model = "MT6750 tablet k50v1";
@@ -74,20 +75,22 @@ ram_console@44400000 {
 		};
 
 		/*
-		 * Inside the stock pstore region (which survives the BROM/DA readback);
-		 * the upper part is the bring-up entry marker + RAM console.
+		 * Exactly the stock 3.18 ramoops parameters (mem 0xe0000, record 4K,
+		 * console 256K, ftrace 4K, pmsg 64K, ecc 0): both kernels place the
+		 * console zone at 0x4449f000, so after a reboot into stock Android our
+		 * log shows up as /sys/fs/pstore/console-ramoops.
 		 */
 		ramoops@44410000 {
 			compatible = "ramoops";
-			reg = <0x0 0x44410000 0x0 0x70000>;
+			reg = <0x0 0x44410000 0x0 0xe0000>;
 			record-size = <0x1000>;
 			console-size = <0x40000>;
 			ftrace-size = <0x1000>;
 			pmsg-size = <0x10000>;
 		};
 
-		bringup-ramcon@44480000 {
-			reg = <0x0 0x44480000 0x0 0x20000>;
+		bringup-ramcon@b00c0000 {
+			reg = <0x0 0xb00c0000 0x0 0x40000>;
 			no-map;
 		};
 
@@ -164,6 +167,124 @@ lk-overlay-sink {
 		keypad: keypad { status = "disabled"; };
 	};
 
+	/*
+	 * Stage 2: no clock/PMIC drivers yet. Describe the clocks and supplies
+	 * exactly as lk/preloader left them (fixed, always on, values from the
+	 * stock kernel's clk_summary) so mtk-sd / mtu3 / t-phy can probe.
+	 */
+	msdc0_src_clk: msdc0-src-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		/* stock: msdcpll 383.5 MHz; declared high so the divider never overclocks */
+		clock-frequency = <400000000>;
+	};
+
+	msdc0_hclk: msdc0-hclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <273000000>;
+	};
+
+	ssusb_sys_clk: ssusb-sys-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <124800000>;
+	};
+
+	clk26m_ref: clk26m-ref {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <26000000>;
+	};
+
+	vemc_fixed: regulator-vemc {
+		compatible = "regulator-fixed";
+		regulator-name = "vemc33";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		regulator-always-on;
+	};
+
+	vio18_fixed: regulator-vio18 {
+		compatible = "regulator-fixed";
+		regulator-name = "vio18";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	vusb33_fixed: regulator-vusb33 {
+		compatible = "regulator-fixed";
+		regulator-name = "vusb33";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	mmc0: mmc@11230000 {
+		compatible = "mediatek,mt6755-mmc", "mediatek,mt2701-mmc";
+		reg = <0 0x11230000 0 0x1000>;
+		interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_LOW>;
+		clocks = <&msdc0_src_clk>, <&msdc0_hclk>;
+		clock-names = "source", "hclk";
+		bus-width = <8>;
+		/* bring-up: legacy timing only, no HS200/HS400 tuning yet */
+		max-frequency = <25000000>;
+		cap-mmc-highspeed;
+		non-removable;
+		no-sd;
+		no-sdio;
+		vmmc-supply = <&vemc_fixed>;
+		vqmmc-supply = <&vio18_fixed>;
+		/* bring-up: no pinctrl driver yet, keep lk's pin setup */
+		mediatek,pins-preset;
+	};
+
+	/* PHY ("ssusb_sif2" in stock DT) is at 0x11290000; 0x11280000 is the IPPC/SIF of the MAC. */
+	/* T-PHY v1 (vendor mu3phy: SPLLC 0x0, FMREG 0x100, IPPC/CHIP 0x700, U2 0x800, U3 0x900) */
+	u3phy: t-phy@11290000 {
+		compatible = "mediatek,mt6755-tphy", "mediatek,generic-tphy-v1";
+		/* shared SPLLC/FMREG banks only; IPPC at +0x700 belongs to mtu3 */
+		reg = <0 0x11290000 0 0x800>;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		u2port0: usb-phy@11290800 {
+			reg = <0 0x11290800 0 0x100>;
+			clocks = <&clk26m_ref>;
+			clock-names = "ref";
+			#phy-cells = <1>;
+			/* MT6755: VBUS is sensed by the PMIC; stock forces the session */
+			mediatek,force-vbus;
+		};
+
+		/* U3 PHY banks (PHYD/PHYD_B2/PHYA/PHYA_DA): its PLL feeds SSUSB sys125/syspll */
+		u3port0: usb-phy@11290900 {
+			reg = <0 0x11290900 0 0x700>;
+			clocks = <&clk26m_ref>;
+			clock-names = "ref";
+			#phy-cells = <1>;
+		};
+	};
+
+	ssusb: usb@11271000 {
+		compatible = "mediatek,mt6755-mtu3", "mediatek,mtu3";
+		reg = <0 0x11271000 0 0x2e00>, <0 0x11280700 0 0x100>;
+		reg-names = "mac", "ippc";
+		interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_LOW>;
+		phys = <&u2port0 PHY_TYPE_USB2>;
+		mediatek,u3p-dis-msk = <1>;
+		clocks = <&ssusb_sys_clk>;
+		clock-names = "sys_ck";
+		vusb33-supply = <&vusb33_fixed>;
+		dr_mode = "peripheral";
+		maximum-speed = "high-speed";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+	};
+
 	watchdog@10007000 {
 		compatible = "mediatek,mt6589-wdt";
 		/* stock reboot = AUTO_RESTART|EXTEN, else the preloader powers off */
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 23ac1e064..154bd5476 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -149,6 +149,15 @@ SYM_CODE_START(primary_entry)
 	movz	w12, #0xc242
 	movk	w12, #0x8545, lsl #16		/* VEMC on */
 	bl	bringup_pwrap_write
+	/*
+	 * MT6353 TOP_RST_MISC_SET (0x02aa) = 1: RG_WDTRSTB_EN. Make the PMIC
+	 * power-cycle all rails on a SoC watchdog reset (WDT_MODE EXTEN), as the
+	 * stock kernel's PMIC init does; without it a WDT reset leaves the board
+	 * half-reset and the boot ROM loops in download mode, then powers off.
+	 */
+	movz	w12, #0x0001
+	movk	w12, #0x8155, lsl #16
+	bl	bringup_pwrap_write
 	movz	x9, #0x7000
 	movk	x9, #0x1000, lsl #16		/* TOPRGU WDT_MODE */
 	ldr	w10, [x9]
diff --git a/arch/arm64/kernel/psci.c b/arch/arm64/kernel/psci.c
index fabd732d0..52afe0100 100644
--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -36,10 +36,25 @@ static int __init cpu_psci_cpu_prepare(unsigned int cpu)
 	return 0;
 }
 
+/*
+ * MediaTek MT6755-class firmware: PSCI CPU_ON only records the entry point;
+ * the kernel must power the core up through the SPM afterwards (stock
+ * "mt-boot" enable-method). Overridden by drivers/soc/mediatek/mt6755-bringup.c.
+ */
+int __weak mtk_spm_cpu_can_boot(u64 mpidr) { return 0; }
+int __weak mtk_spm_cpu_power_on(u64 mpidr) { return 0; }
+
 static int cpu_psci_cpu_boot(unsigned int cpu)
 {
 	phys_addr_t pa_secondary_entry = __pa_symbol(secondary_entry);
-	int err = psci_ops.cpu_on(cpu_logical_map(cpu), pa_secondary_entry);
+	int err;
+
+	err = mtk_spm_cpu_can_boot(cpu_logical_map(cpu));
+	if (err)
+		return err;
+	err = psci_ops.cpu_on(cpu_logical_map(cpu), pa_secondary_entry);
+	if (!err)
+		err = mtk_spm_cpu_power_on(cpu_logical_map(cpu));
 	if (err && err != -EPERM)
 		pr_err("failed to boot CPU%d (%d)\n", cpu, err);
 
