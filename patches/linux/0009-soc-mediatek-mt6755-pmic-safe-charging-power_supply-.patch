From abfcc162150c8d66f779d3cbcd0988c5dba32c0e Mon Sep 17 00:00:00 2001
From: Pasquale Minervini <p.minervini@gmail.com>
Date: Sat, 7 Nov 2026 23:02:34 +0000
Subject: [PATCH 09/33] soc: mediatek: mt6755-pmic: safe charging,
 power_supply, RTC, boot-recovery flag, power-off; dts: DISP_PWM backlight

- charge control: battery NTC (AUXADC ch3, 16.9k pull-up, 10k NTC), charge only 0..45 C
  (resume 3..42 C), NTC open/short = no charging, full detection (>=4.15 V and <100 mA for
  60 s, recharge <4.10 V), software VBAT cap 4.25 V; orderly power-off below 3.45 V
- power_supply 'battery' (status/health/V/I/temp/capacity from the tablet's stock 25 C OCV
  profile) and 'usb'
- RTC class device for the MT6353 RTC (PMIC 0x4000, year base 1968), hctosys/systohc
- /sys/kernel/mt6755_pmic/boot_recovery: RTC_PDN1 FAC_RESET, lk's one-shot recovery flag
- pm power-off: RTC BBPU pwrdown as stock mt_power_off(), restart if a charger keeps us up
- dts: DISP_PWM (mt8173-compatible) + pwm-backlight, 26 MHz stand-in clock reproduces lk's
  clk_div 0 / period 1023
---
 .../boot/dts/mediatek/mt6750-k50v1-tablet.dts |  22 +
 drivers/soc/mediatek/mt6755-pmic.c            | 561 +++++++++++++++++-
 2 files changed, 556 insertions(+), 27 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
index 910ccb2da..60e97e07f 100644
--- a/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6750-k50v1-tablet.dts
@@ -294,6 +294,28 @@ ssusb: usb@11271000 {
 		ranges;
 	};
 
+	/*
+	 * LCD backlight: DISP_PWM (stock led_mode 5, CUST_BLS_PWM). lk leaves it
+	 * enabled at clk_div 0 / period 1023; with the 26 MHz stand-in clock a
+	 * 39385 ns period reproduces exactly those register values, so the
+	 * backlight driver IC sees the same PWM frequency as under stock.
+	 */
+	disp_pwm: pwm@1100e000 {
+		compatible = "mediatek,mt6595-disp-pwm";
+		reg = <0 0x1100e000 0 0x1000>;
+		#pwm-cells = <2>;
+		clocks = <&clk26m_ref>, <&clk26m_ref>;
+		clock-names = "main", "mm";
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&disp_pwm 0 39385>;
+		brightness-levels = <0 1023>;
+		num-interpolated-steps = <1023>;
+		default-brightness-level = <300>;
+	};
+
 	/*
 	 * Connectivity (out-of-tree modules in mainline/connsys): BTIF + APDMA
 	 * channels, CONSYS (WMT), WiFi AHB window. Clock gates are on from boot
diff --git a/drivers/soc/mediatek/mt6755-pmic.c b/drivers/soc/mediatek/mt6755-pmic.c
index 55dfaea61..ccfd84d38 100644
--- a/drivers/soc/mediatek/mt6755-pmic.c
+++ b/drivers/soc/mediatek/mt6755-pmic.c
@@ -12,8 +12,21 @@
  *    CHR_EN if the hardware dropped it. Charge voltage is left at the PMIC
  *    reset default (4.2 V for this trim), current is 450 mA (USB). The PMIC's
  *    own VBAT over-voltage cut (4.3 V) and BATON check stay enabled.
- *  - /sys/kernel/mt6755_pmic/{battery_mv,charge_ma,charging}: AUXADC readout
- *    (BATSNS/ISENSE, 56 mOhm sense resistor).
+ *  - /sys/kernel/mt6755_pmic/{battery_mv,charge_ma,charging,state}: AUXADC
+ *    readout (BATSNS/ISENSE, 56 mOhm sense resistor).
+ *  - charge control (sampled every 2 s): battery NTC on AUXADC ch3 (BATON,
+ *    16.9k pull-up to 1.8 V, 10k NTC, stock table), charging only inside
+ *    0..45 C (resume 3..42 C), stop when full (>= 4.15 V and < 100 mA taper
+ *    for 60 s, recharge below 4.10 V), software VBAT cap 4.25 V, NTC open/
+ *    short = no charging. Orderly power-off below 3.45 V when not charging.
+ *  - power_supply "battery" (status/health/voltage/current/temp/capacity,
+ *    capacity from the stock 25 C OCV profile of this tablet's 4.2 V cell)
+ *    and "usb" (online = charger detected).
+ *  - rtc: MT6353 RTC (MT6397 layout at PMIC 0x4000), year base 1968 as stock.
+ *  - /sys/kernel/mt6755_pmic/boot_recovery: RTC_PDN1 FAC_RESET, the flag stock
+ *    `reboot recovery` sets; lk boots `recovery` once and clears it.
+ *  - power-off: stock mt_power_off() (RTC BBPU pwrdown = PWRBB low); if a
+ *    charger keeps the PMIC up, restart instead (as stock does).
  */
