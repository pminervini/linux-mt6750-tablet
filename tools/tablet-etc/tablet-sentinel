class FM:
    """One silent tuner: sweep first, then dwell for RDS and digital audio."""
    def __init__(self, enabled=True):
        self.tuner = self.capture = None
        self.samples, self.names, self.bins = {}, {}, []
        self.buffer, self.pcm = b'', b''
        self.frequency = self.target = None
        self.status, self.audio = 'FM unavailable', 'audio unavailable'
        self.phase, self.deadline, self.audio_at = 'off', 0, 0
        self.tuned_at, self.rds_pi = 0, None
        self.capture_ready = False
        self.audio_armed, self.controls = False, None
        self.control_deadline = self.control_at = self.capture_deadline = 0
        self.capture_live = False
        self.capture_status = 'PCM unavailable: kernel FM capture absent'
        self.audio = self.capture_status
        self.level_dbfs = self.peak_dbfs = self.clipped = None
        self.targets = []
        self.index = 0
        if not enabled or not Path('/dev/fm').exists():
            return
        try:
            # Do not steal an already-open receiver, or activate an analogue path.
            busy = subprocess.run(['fuser', '/dev/fm'], capture_output=True, timeout=2)
            if busy.returncode != 1:
                raise RuntimeError('receiver busy or ownership unknown')
            self.silent_preflight()
            # PCM is optional. The deployed legacy helper treats unknown commands as
            # status, so require both the module and the new backend's exact reply.
            if Path('/sys/module/snd_soc_mt6755_tablet').exists():
                self.capture_status = 'PCM unavailable: backend not verified'
                try:
                    check = subprocess.run(['/usr/local/sbin/tablet-audio', 'fm-check'], capture_output=True, text=True, timeout=2)
                    self.capture_ready = check.returncode == 0 and check.stdout.strip() == 'MT6755 FM capture backend available; hardware reception remains unverified'
                except (OSError, subprocess.TimeoutExpired):
                    pass
            self.audio = self.capture_status
            self.tuner = subprocess.Popen(['/usr/local/bin/fmctl', '-m', '87.5'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            os.set_blocking(self.tuner.stdout.fileno(), False)
            self.target, self.phase, self.status = 8750, 'tuning', 'awaiting tune: 87.5 MHz'
            self.deadline = time.monotonic()+8
        except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
            self.status = f'FM unavailable: {error}'
            self.close()

    def silent_preflight(self, capture_state=None):
        """Fail closed on unknown codec state or an enabled amplifier pin.

        The audited legacy status path reads aligned registers and only selects
        PMIC read addresses. GPIO inspection below maps device memory read-only;
        it never changes the amplifier, pin mux, or output levels.
        """
        active = False
        if capture_state is None:
            status = subprocess.run(['/usr/local/sbin/tablet-audio', 'status'], capture_output=True, text=True, timeout=2)
            expected = {'PWR_STATUS.audio': '0', 'DAC_CON0': '0x00000000',
                        'ADDA_DL': '0x00000000', 'AUDDEC0': '0x0000', 'UL_DL': '0x0000'}
            if status.returncode or any(re.findall(r'(?<!\S)'+re.escape(key)+r'=([^\s]+)', status.stdout) != [value] for key, value in expected.items()):
                raise RuntimeError('silent preflight failed: codec state unsafe or unknown')
        else:
            parameters = Path('/sys/module/snd_soc_mt6755_tablet/parameters')
            if any((parameters/key).read_text().strip() != value for key, value in
                   (('allow_playback', 'N'), ('allow_capture', 'Y'), ('legacy_quiesced', 'Y'))):
                raise RuntimeError('silent capture policy unsafe or unknown')
            # Read the owner directly: the legacy status helper rejects active users.
            tokens = Path('/sys/bus/platform/devices/mt6755-tablet/capture_status').read_text().split()
            fields = dict(token.split('=', 1) for token in tokens)
            required = {'users', 'capture_prepared', 'capture_running', 'codec_on', 'gpio_mapped',
                        'PWR_STATUS.audio', 'DAC_CON0', 'ADDA_DL', 'AUDDEC0', 'UL_DL',
                        'AWB_BASE', 'AWB_CUR', 'AWB_END', 'capture_xrun'}
            if len(fields) != len(tokens) or not required <= fields.keys():
                raise RuntimeError('silent capture status missing or duplicate')
            values = {key: int(fields[key], 16 if fields[key].startswith('0x') else 10) for key in required}
            active = values['capture_prepared'] == values['capture_running'] == 1
            if (any(values[key] != 0 for key in ('codec_on', 'gpio_mapped', 'AUDDEC0', 'UL_DL', 'capture_xrun')) or
                any(values[key] not in (0, 1) for key in ('users', 'capture_prepared', 'capture_running', 'PWR_STATUS.audio')) or
                values['ADDA_DL'] & 0x00ffffff or values['DAC_CON0'] & 0x07ffffff not in (0, 0x41) or
                (capture_state == 'idle' and (values['DAC_CON0'] & 0x07ffffff or any(values[key] for key in ('users', 'capture_prepared', 'capture_running', 'PWR_STATUS.audio')))) or
                values['capture_running'] > values['capture_prepared'] or values['capture_prepared'] > values['users'] or
                (capture_state == 'running' and not active) or
                (active and (values['users'] != 1 or values['PWR_STATUS.audio'] != 1 or values['DAC_CON0'] & 0x07ffffff != 0x41 or
                             not 0 < values['AWB_BASE'] <= values['AWB_CUR'] <= values['AWB_END']))):
                raise RuntimeError('silent capture state unsafe or unknown')
        fd = os.open('/dev/mem', os.O_RDONLY | os.O_SYNC)
        try:
            with mmap.mmap(fd, 4096, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ, offset=0x10005000) as gpio:
                for pin in (0, 54, 62):
                    mode_word = struct.unpack_from('<I', gpio, 0x300+(pin//10)*0x10)[0]
                    index = pin % 10
                    shift = index*3 if index < 5 else 16+(index-5)*3
                    output = struct.unpack_from('<I', gpio, 0x100+(pin//32)*0x10)[0]
                    if (mode_word >> shift) & 7 or (output >> (pin % 32)) & 1:
                        raise RuntimeError(f'silent preflight failed: GPIO{pin} must be MODE0/DOUT0')
        finally:
            os.close(fd)
        return active

    def tune(self, frequency, phase):
        self.stop_capture()
        # Discard queued old-channel reports before sending the next tune. A
        # matching acknowledgement is still required before consuming new data.
        drained = 0
        while True:
            try:
                pending = os.read(self.tuner.stdout.fileno(), 16384)
            except BlockingIOError:
                break
            if not pending:
                raise RuntimeError('receiver exited before retune')
            drained += len(pending)
            if drained > 65536:
                raise RuntimeError('oversized receiver output before retune')
        self.target, self.frequency, self.phase = frequency, None, phase
        self.tuned_at, self.rds_pi, self.buffer = 0, None, b''
        # Retained band labels keep their old observation times; revisiting this
        # channel cannot present an old name as a newly decoded current station.
        self.names.pop(frequency, None)
        self.status = f'awaiting tune: {frequency/100:.1f} MHz'
        self.bins, self.audio = [], ('audio waiting for station dwell' if self.capture_ready else self.capture_status)
        self.level_dbfs = self.peak_dbfs = self.clipped = None
        self.audio_at = 0
        self.tuner.stdin.write(f't {frequency/100:.2f}\nr\n'.encode())
        self.tuner.stdin.flush()
        self.deadline = time.monotonic()+8

    def stop_capture(self):
        remute = self.audio_armed or self.capture is not None
        self.audio_armed, self.controls, self.capture_live = False, None, False
        self.control_deadline = self.control_at = self.capture_deadline = 0
        self.pcm, self.bins, self.audio_at = b'', [], 0
        self.level_dbfs = self.peak_dbfs = self.clipped = None
        try:
            if remute and self.tuner is not None and self.tuner.poll() is None:
                self.tuner.stdin.write(b'm\nv 0\n')
                self.tuner.stdin.flush()
        finally:
            if self.capture is not None:
                child, self.capture = self.capture, None
                try:
                    if child.poll() is None:
                        child.terminate()
                    try:
                        # arecord can flush a full pipe on TERM; drain while reaping.
                        child.communicate(timeout=1)
                    except subprocess.TimeoutExpired:
                        child.kill()
                        child.communicate(timeout=1)
                finally:
                    child.stdout.close()

    def poll(self):
        if self.tuner is None:
            return
        now = time.monotonic()
        try:
            if self.tuner.poll() is not None:
                raise RuntimeError('receiver exited')
            try:
                self.buffer += os.read(self.tuner.stdout.fileno(), 16384)
            except BlockingIOError:
                pass
            if len(self.buffer) > 65536:
                raise RuntimeError('oversized receiver output')
            while b'\n' in self.buffer:
                raw, self.buffer = self.buffer.split(b'\n', 1)
                line = raw.decode('ascii', errors='replace')
                if line.startswith('tuned '):
                    frequency = round(float(line.split()[1])*100)
                    if frequency != self.target:
                        raise RuntimeError('unexpected tuned frequency')
                    self.frequency, self.tuned_at = frequency, now
                elif line.startswith('rssi ') and self.frequency is not None:
                    rssi = int(line.split()[1])
                    self.samples[self.frequency] = (rssi, now)
                    if self.phase == 'tuning':
                        self.phase, self.deadline = 'sweep', now+0.12
                    elif self.phase == 'station-tuning':
                        self.phase, self.deadline = 'dwell', now+6
                        if self.capture_ready:
                            self.audio_armed = True  # Cleanup covers even a failed setup.
                            try:
                                import numpy  # Load before gain/unmute or DMA, never an RF prerequisite.
                                self.silent_preflight('idle')
                                self.controls, self.control_deadline = {}, time.monotonic()+2
                                self.tuner.stdin.write(b'v 1\nu\ng 7d\ng 9c\n')
                                self.tuner.stdin.flush()
                                self.audio = 'verifying digital capture controls'
                            except (OSError, ValueError, RuntimeError, ImportError):
                                self.stop_capture()
                                self.audio = 'FM digital capture unavailable'
                        else:
                            self.audio = self.capture_status
                elif line.startswith('rds PI ') and self.frequency is not None and self.phase in ('station-tuning', 'dwell'):
                    pi = int(line.split()[2], 16)
                    if pi != self.rds_pi:
                        self.names.pop(self.frequency, None)
                    self.rds_pi = pi
                elif line.startswith('rds PS "') and self.frequency is not None and self.phase in ('station-tuning', 'dwell') and self.rds_pi is not None:
                    name = line[len('rds PS "'):].rstrip('"').strip()
                    if name:
                        self.names[self.frequency] = (name[:8], now)
                elif self.audio_armed and line.startswith(('reg ', 'headphones out:')):
                    match = re.fullmatch(r'reg (7d|9c) = ([0-9a-fA-F]{4})', line)
                    if (match is None or self.controls is None or match[1] in self.controls or
                        (int(match[2], 16) != 0x040c if match[1] == '7d' else int(match[2], 16) & 3 != 0)):
                        self.stop_capture()
                        self.audio = 'FM digital capture unavailable: mute/gain readback'
                    else:
                        self.controls[match[1]] = int(match[2], 16)
                elif any(line.startswith(prefix) for prefix in ('tune:', 'power up:', 'muted startup:', 'mute:', 'volume:', 'rssi:')):
                    raise RuntimeError('receiver command failed')
            try:
                if self.audio_armed:
                    if self.capture is not None and not self.capture_live and now >= self.capture_deadline:
                        raise RuntimeError('digital capture startup timeout')
                    if self.capture is None:
                        self.silent_preflight('idle')
                    else:
                        self.capture_live = self.silent_preflight('running' if self.capture_live else 'starting')
                    if self.controls is not None:
                        if now >= self.control_deadline:
                            raise RuntimeError('mute/gain readback timeout')
                        if len(self.controls) == 2:
                            self.controls, self.control_at = None, now+0.5
                            if self.capture is None:
                                self.capture_deadline = time.monotonic()+2
                                self.capture = subprocess.Popen(['/usr/local/sbin/tablet-audio', 'fm-record', '5', '-'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                                os.set_blocking(self.capture.stdout.fileno(), False)
                                self.audio = 'starting digital capture'
                    elif now >= self.control_at:
                        self.controls, self.control_deadline = {}, now+2
                        self.tuner.stdin.write(b'g 7d\ng 9c\n')
                        self.tuner.stdin.flush()
            except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as error:
                self.stop_capture()
                self.audio = f'FM digital capture unavailable: {error}'
            if self.bins and now-self.audio_at > 0.5:
                self.bins, self.pcm = [], b''
                self.level_dbfs = self.peak_dbfs = self.clipped = None
                self.audio = 'audio capture ended / not live'
            if self.capture is not None:
                eof = False
                try:
                    chunk = os.read(self.capture.stdout.fileno(), 65536)
                    eof = not chunk
                    if self.audio_armed and not self.capture_live:
                        chunk, self.pcm = b'', b''
                    new_frames = (len(self.pcm) % 4 + len(chunk)) // 4
                    self.pcm += chunk
                    if len(self.pcm) > 16384:
                        self.pcm = self.pcm[((len(self.pcm)-16384+3)//4)*4:]
                    if len(self.pcm) >= 4096 and new_frames:
                        import numpy as np
                        complete = len(self.pcm)//4*4
                        stereo = np.frombuffer(self.pcm[complete-4096:complete], dtype='<i2').reshape(-1, 2).astype(float)/32768
                        self.level_dbfs = float(20*np.log10(max(float(np.sqrt(np.mean(stereo**2))), 1e-6)))
                        self.peak_dbfs = float(20*np.log10(max(float(np.abs(stereo).max()), 1e-6)))
                        self.clipped = bool(np.any(np.abs(stereo) >= 32767/32768))
                        pcm = stereo.mean(axis=1)
                        spectrum = np.abs(np.fft.rfft(pcm*np.hanning(len(pcm))))*4/len(pcm)
                        edges = np.geomspace(1, len(spectrum)-1, 41).astype(int)
                        self.bins = [float(20*np.log10(max(float(spectrum[a:max(a+1,b)].max()), 1e-6))) for a,b in zip(edges, edges[1:])]
                        self.audio_at = now
                        self.audio = 'FM audio / dBFS' if np.any(stereo) else 'digital silence / no audio signal'
                except BlockingIOError:
                    pass
                if eof or self.capture.poll() is not None:
                    self.audio = 'FM digital capture unavailable' if self.capture.returncode or not self.pcm else 'audio capture ended / not live'
                    self.stop_capture()
            if now >= self.deadline:
                if self.phase in ('tuning', 'station-tuning'):
                    raise RuntimeError('tuner response timeout')
                if self.phase == 'sweep':
                    if self.target < 10800:
                        self.tune(self.target+10, 'tuning')
                    else:
                        # Separate nearby peaks; decode names over the air, never guess.
                        self.targets = []
                        for frequency in sorted(self.samples, key=lambda f: self.samples[f][0], reverse=True):
                            if all(abs(frequency-other) >= 20 for other in self.targets):
                                self.targets.append(frequency)
                            if len(self.targets) == 8:
                                break
                        self.index = 0
                        self.tune(self.targets[0], 'station-tuning')
                elif self.phase == 'dwell':
                    self.index += 1
                    if self.index < len(self.targets):
                        self.tune(self.targets[self.index], 'station-tuning')
                    else:
                        self.tune(8750, 'tuning')
            if self.phase in ('tuning', 'station-tuning'):
                self.status = f'awaiting tune: {self.target/100:.1f} MHz'
            else:
                self.status = 'RDS dwell' if self.phase == 'dwell' else 'sequential band sweep'
        except (OSError, ValueError, RuntimeError, ImportError, subprocess.TimeoutExpired) as error:
            self.status, self.audio, self.bins = f'FM stopped: {error}', 'audio unavailable', []
            self.close()

    def close(self):
        self.frequency = self.target = None
        self.phase, self.rds_pi = 'off', None
        self.bins = []
        self.level_dbfs = self.peak_dbfs = self.clipped = None
        self.audio_at = 0
        try:
            self.stop_capture()
        finally:
            if self.tuner is not None:
                try:
                    if self.tuner.poll() is None:
                        self.tuner.stdin.write(b'q\n')
                        self.tuner.stdin.flush()
                except (OSError, ValueError):
                    pass
                try:
                    self.tuner.stdin.close()
                except OSError:
                    pass
                try:
                    self.tuner.wait(timeout=0.5)
                except subprocess.TimeoutExpired:
                    self.tuner.terminate()
                    try:
                        self.tuner.wait(timeout=0.5)
                    except subprocess.TimeoutExpired:
                        self.tuner.kill()
                        self.tuner.wait(timeout=0.5)
                self.tuner.stdout.close()
                self.tuner = None


def read(path, default='?'):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def counters():
    cpu = {}
    for row in read('/proc/stat', '').splitlines():
        name, *fields = row.split()
        if name.startswith('cpu'):
            v = list(map(int, fields[:8]))
            cpu[name] = (sum(v), v[3] + v[4])
    net = {name: tuple(int(read(f'/sys/class/net/{name}/statistics/{d}_bytes', '0')) for d in ('rx', 'tx')) for name in ('wlan0', 'tun0')}
    return time.monotonic(), cpu, net


def gps_poll(gps):
    now = time.monotonic()
    try:
        if gps['socket'] is None and now >= gps['retry']:
            gps['socket'] = socket.create_connection(('127.0.0.1', 2947), timeout=0.15)
            gps['socket'].sendall(b'?WATCH={"enable":true,"json":true};\n')
            gps['socket'].setblocking(False)
        if gps['socket'] is not None:
            while True:
                chunk = gps['socket'].recv(16384)
                if not chunk:
                    raise ConnectionError('gpsd closed')
                gps['buffer'] += chunk
                while b'\n' in gps['buffer']:
                    row, gps['buffer'] = gps['buffer'].split(b'\n', 1)
                    j = json.loads(row)
                    if j.get('class') == 'TPV':
                        # Discard coordinates and all unrelated fields immediately.
                        gps['mode'], gps['tpv_at'] = j.get('mode'), now
                        gps['fix_time'] = j.get('time')
                    elif j.get('class') == 'SKY':
                        gps['used'] = j.get('uSat', sum(bool(s.get('used')) for s in j.get('satellites', [])))
                        gps['sky_at'] = now
                if len(gps['buffer']) > 65536:
                    raise ValueError('oversized gpsd record')
    except BlockingIOError:
        pass
    except (OSError, ValueError):
        if gps['socket'] is not None:
            gps['socket'].close()
        gps['socket'], gps['buffer'], gps['retry'] = None, b'', now + 5


def telemetry(previous, gps):
    current = counters()
    dt = max(0.001, current[0] - previous[0])
    cpu = {}
    for name, (total, idle) in current[1].items():
        t0, i0 = previous[1].get(name, (total, idle))
        cpu[name] = f'{100 * (1 - (idle-i0)/(total-t0)):.1f}%' if total > t0 and dt >= 0.5 else '--'
    net = {name: tuple(f'{max(0, b-a)/dt/1024:.1f}' if dt >= 0.5 else '--' for a, b in zip(previous[2][name], values)) for name, values in current[2].items()}
    mem = dict(re.findall(r'(\w+):\s+(\d+) kB', read('/proc/meminfo', '')))
    used = (int(mem['MemTotal']) - int(mem['MemAvailable'])) / 1024
    total = int(mem['MemTotal']) / 1024
    b = '/sys/class/power_supply/battery/'
    try:
        amps = int(read(b+'current_now')) / 1e6
        volts = int(read(b+'voltage_now')) / 1e6
        power = f'{amps*1000:+.0f}mA {volts:.2f}V {abs(amps*volts):.2f}W'
        battery_temp = f'{int(read(b+"temp"))/10:.1f}C'
    except ValueError:
        power, battery_temp = 'unavailable', '?'
    temps = {read(p+'/type'): read(p+'/temp') for p in glob.glob('/sys/class/thermal/thermal_zone*')}
    try:
        cpu_temp = f'{int(temps["cpu-thermal"])/1000:.1f}C'
    except (KeyError, ValueError):
        cpu_temp = '?'
    disk = os.statvfs('/')
    uptime = int(float(read('/proc/uptime', '0').split()[0]))
    try:
        link = subprocess.run(['/usr/sbin/iw', 'dev', 'wlan0', 'link'], capture_output=True, text=True, timeout=0.5).stdout
    except (OSError, subprocess.TimeoutExpired):
        link = ''
    wireless = re.search(r'signal:\s+(-?[\d.]+) dBm', link)
    wifi = f'{float(wireless[1]):.0f}dBm' if wireless else 'signal unavailable'
    mode = {1:'no fix', 2:'2D fix', 3:'3D fix'}.get(gps['mode'], 'awaiting reports')
    age = time.monotonic() - gps['tpv_at']
    if age > 10:
        mode = 'stale reports' if gps['tpv_at'] else 'awaiting reports'
    if gps['mode'] in (2, 3) and gps['fix_time']:
        try:
            fix_time = datetime.datetime.fromisoformat(gps['fix_time'].replace('Z', '+00:00'))
            if abs(time.time() - fix_time.timestamp()) > 15:
                mode = 'stale fix'
        except ValueError:
            mode = 'fix time unknown'
    sats = str(gps['used']) if time.monotonic()-gps['sky_at'] <= 10 else '?'
    role_paths = glob.glob('/sys/class/usb_role/*/role')
    role = read(role_paths[0]) if role_paths else '?'
    try:
        failed = subprocess.run(['systemctl', '--failed', '--no-legend', '--plain', '--no-pager'], capture_output=True, text=True, timeout=0.5)
        failed_count = str(len(failed.stdout.splitlines())) if failed.returncode == 0 else 'unknown'
    except (OSError, subprocess.TimeoutExpired):
        failed_count = 'unknown'
    warnings = []
    # Display-only low-battery indication; this does not change power policy.
    capacity = read(b+'capacity')
    if capacity.isdigit() and int(capacity) <= 15:
        warnings.append('battery <=15%')
    health = read(b+'health', 'unknown').lower()
    if health not in ('good', 'unknown'):
        warnings.append('battery '+health)
    for path in glob.glob('/sys/class/thermal/thermal_zone*'):
        for trip in glob.glob(path+'/trip_point_*_type'):
            limit = read(trip.replace('_type', '_temp'), '')
            value = read(path+'/temp', '')
            if read(trip) in ('hot', 'critical') and limit.isdigit() and value.isdigit() and int(value) >= int(limit):
                warnings.append('thermal '+read(trip))
    if cpu_temp == '?' or battery_temp == '?' or not capacity.isdigit():
        warnings.append('sensor missing')
    if health == 'unknown':
        warnings.append('battery health unknown')
    return current, [
        ('CPU / MEMORY', [f'load {cpu.get("cpu", "--")} / {cpu_temp}', f'RAM {used:.0f}/{total:.0f} MiB', '0-3 '+ ' '.join(cpu.get(f'cpu{i}', '--') for i in range(4)), '4-7 '+ ' '.join(cpu.get(f'cpu{i}', '--') for i in range(4,8)), f'DVFS {read("/run/tablet-cpufreq")}', 'load '+ ' '.join(read('/proc/loadavg', '?').split()[:3])]),
        ('NETWORK / SYSTEM', [f'wlan RX/TX {"/".join(net["wlan0"])} KiB/s', f'VPN  RX/TX {"/".join(net["tun0"])} KiB/s', f'Wi-Fi {wifi}', f'USB {role} / charger '+read('/sys/class/power_supply/usb/online'), f'disk free {disk.f_bavail*disk.f_frsize/2**30:.1f} GiB', f'up {uptime//86400}d {uptime%86400//3600:02}:{uptime%3600//60:02}:{uptime%60:02}']),
        ('GPS / POWER', [f'GPS {mode} / {sats} used', 'position hidden', f'battery {capacity}% / {battery_temp}', power, read(b+'status').lower(), f'charge band {read(b+"charge_control_start_threshold")}-{read(b+"charge_control_end_threshold")}%']),
        ('HEALTH / AUDIO', [f'failed services: {failed_count}', 'warnings: '+(', '.join(dict.fromkeys(warnings)) or 'none observed'), 'GPS data: '+('stale/unknown' if age > 10 or mode in ('stale fix', 'fix time unknown') else 'fresh')])
    ]


def background(rotation, sections, ends_at, fm=None):
    w, h = (1280, 800) if rotation % 2 else (800, 1280)
    image = Image.new('L', (w, h), 0)
    d = ImageDraw.Draw(image)
    font = ImageFont.truetype(FONT, 14 if w > h else 17)
    title = ImageFont.truetype(FONT, 18)
    small = ImageFont.truetype(FONT, 13)
    margin = 56 if w > h else 36
    d.text((margin, 40), 'mediatek:~$ sentinel --ambient', font=title, fill=255)
    clock = time.strftime('%H:%M:%S')
    d.text((w-margin, 40), clock, anchor='ra', font=title, fill=255)
    d.line((margin, 85, w-margin, 85), fill=255)
    d.text((margin, 102), f'MT6750 / NATIVE LINUX / ROTATION {rotation*90:03} DEG', font=small, fill=255)
    d.text((w-margin, 102), 'CAMERA OFF', anchor='ra', font=small, fill=255)
    now = time.monotonic()
    audio_age = now-fm.audio_at if fm is not None and fm.audio_at else None
    fresh_audio = bool(fm is not None and fm.bins and audio_age is not None and audio_age <= 0.5)
    if fm is not None:
        top = 327 if w > h else 380
        frequency = f'{fm.frequency/100:.1f} MHz' if fm.frequency is not None else '-- MHz'
        name, named_at = fm.names.get(fm.frequency, ('RDS awaiting name', 0))
        if named_at < fm.tuned_at:
            name, named_at = 'RDS awaiting name', 0
        if named_at:
            name += f' ({max(0, int(time.monotonic()-named_at))}s)'
        d.text((margin, top), f'FM {frequency} / {name} / {fm.status}'[:100 if w > h else 78], font=small, fill=255)
        left, right, bottom = margin, w-margin, top+84
        d.line((left, bottom, right, bottom), fill=255)
        now = time.monotonic()
        for frequency, (rssi, measured) in fm.samples.items():
            x = left+(right-left)*(frequency-8750)/2050
            height = max(0, min(1, (rssi+120)/80))*48
            d.line((x, bottom-height, x, bottom), fill=255 if now-measured < 120 else 100, width=2)
        for frequency, (name, measured) in sorted(fm.names.items())[:8]:
            x = left+(right-left)*(frequency-8750)/2050
            d.text((max(left, min(right-70, x)), top+20+(frequency//10%2)*15), name, font=small, fill=255 if now-measured < 120 else 100)
        d.text((left, bottom+3), '87.5', font=small, fill=255)
        ages = [max(0, now-measured) for _, measured in fm.samples.values()]
        youngest, oldest = min(ages, default=0), max(ages, default=0)
        d.text((right, bottom+3), f'108 MHz / -120..-40 dBm / age {youngest:.0f}..{oldest:.0f}s', anchor='ra', font=small, fill=255)
        audio_top, audio_bottom = top+112, top+159
        audio_label = 'audio stale / not live' if audio_age is not None and audio_age > 0.5 else fm.audio
        d.text((left, audio_top), audio_label, font=small, fill=255)
        d.text((right, audio_top), '47 Hz - 24 kHz / -90..0 dBFS', anchor='ra', font=small, fill=255)
        for i, value in enumerate(fm.bins if fresh_audio else []):
            x = left+(right-left)*i/len(fm.bins)
            height = max(0, min(1, (value+90)/90))*29
            d.rectangle((x, audio_bottom-height, x+(right-left)/len(fm.bins)-3, audio_bottom), fill=255)
    if w > h:
        positions = [(56, 548), (354, 548), (652, 548), (950, 548)]
        panel_width, line_height = 274, 20
        divider = 534
    else:
        positions = [(36, 590), (420, 590), (36, 896), (420, 896)]
        panel_width, line_height = 344, 25
        divider = 566
    sections = [(label, list(rows)) for label, rows in sections]
    if len(sections) == 3:
        sections.append(('HEALTH / AUDIO', ['failed services: not sampled', 'warnings: not sampled', 'GPS data: not sampled']))
    if fresh_audio and fm.level_dbfs is not None:
        audio_rows = ['capture: '+('digital silence' if fm.peak_dbfs <= -120 else 'live PCM'), f'RMS {fm.level_dbfs:.1f} / peak {fm.peak_dbfs:.1f} dBFS', f'clip {"YES" if fm.clipped else "no"} / age {audio_age:.1f}s']
    else:
        state = 'unavailable' if fm is None else ('stale / not live' if audio_age is not None and audio_age > 0.5 else fm.audio)
        audio_rows = ['capture: '+state, 'RMS / peak: unavailable', 'clip: unknown / age '+(f'{audio_age:.1f}s' if audio_age is not None else '--')]
    sections[3][1].extend(audio_rows)
    d.line((margin, divider, w-margin, divider), fill=255)
    for (label, rows), (x,y) in zip(sections, positions):
        d.text((x,y), label, font=ImageFont.truetype(FONT, 16) if w > h else title, fill=255)
        panel_font = font
        bottom = (862 if y == 590 else h-70) if w < h else h-70
        meter_space = 16 if label == 'HEALTH / AUDIO' and fresh_audio else 0
        # Shrink only this panel's font when many real warnings wrap. Never
        # squeeze baselines closer than the font's height or drop warning rows.
        while True:
            lines = [line for row in rows for line in textwrap.wrap(row, width=int(panel_width/panel_font.getlength('M')))]
            spacing = min(line_height, panel_font.size+5)
            if y+32+spacing*len(lines)+meter_space <= bottom:
                break
            if panel_font.size <= 9:
                raise ValueError(f'telemetry panel exceeds readable cell: {label}')
            panel_font = ImageFont.truetype(FONT, panel_font.size-1)
        for n, line in enumerate(lines):
            d.text((x,y+32+spacing*n), line, font=panel_font, fill=255)
        if label == 'HEALTH / AUDIO' and fresh_audio and fm.level_dbfs is not None:
            meter_y = y+32+spacing*len(lines)+3
            d.rectangle((x, meter_y, x+panel_width, meter_y+6), outline=255)
            level = max(0, min(1, (fm.level_dbfs+90)/90))*panel_width
            peak = max(0, min(1, (fm.peak_dbfs+90)/90))*panel_width
            if level > 0:
                d.rectangle((x, meter_y, x+level, meter_y+6), fill=255)
            d.line((x+peak, meter_y-2, x+peak, meter_y+8), fill=255)
    try:
        state = json.loads(read(STATE, '{}'))
    except ValueError:
        state = {}
    now = time.monotonic()
    idle = max(0, int(now-state.get('last_keyboard', now)))
    check = max(0, int(state.get('next_check', now)-now))
    remaining = max(0, math.ceil(ends_at-now))
    d.line((margin, h-57, w-margin, h-57), fill=255)
    d.text((margin,h-37), f'key idle {idle//3600}h{idle%3600//60:02}m / next check {check//60}m / closes {remaining}s', font=small, fill=255)
    return image


def frame(base, offset, openness=1, compact=False):
    image = base.copy()
    d = ImageDraw.Draw(image)
    w, h = image.size
    scale = min(w/1280, 1)
    top = 155 if w > h else 190
    centre = top + 177*scale
    if compact and w > h:
        centre = 225
    for mirrored in (False, True):
        points = [(160,233),(550,283),(508,404),(305,431),(209,355)]
        points = [((1280-x if mirrored else x)*scale+offset[0], centre+(y-332)*scale*openness*(0.6 if compact and w > h else 1)+offset[1]) for x,y in points]
        d.polygon(points, fill=255)
    return image


def physical(image, rotation):
    # fbcon 1 is clockwise; Pillow ROTATE_270 is clockwise too.
    methods = (None, Image.Transpose.ROTATE_270, Image.Transpose.ROTATE_180, Image.Transpose.ROTATE_90)
    return image.transpose(methods[rotation]) if rotation else image


def volume_overlay(image, level):
    """Selected playback gain, not a measured audio signal."""
    d = ImageDraw.Draw(image)
    w, h = image.size
    width = min(w-72, 640)
    x, y = (w-width)//2, h-170
    d.rectangle((x, y, x+width, y+126), fill='black', outline='white', width=2)
    label = 'VOLUME  0%  /  MUTE' if level == 0 else f'VOLUME  {level}%'
    d.text((w//2, y+18), label, anchor='ma', font=ImageFont.truetype(FONT, 25), fill='white')
    for n in range(20):
        left = x+24+n*(width-48)/20
        d.rectangle((int(left), y+68, int(left+(width-48)/20-5), y+104),
                    fill='white' if n*5 < level else 'black', outline='white', width=1)
    return image


def volume_status():
    try:
        stat = VOLUME.stat()
        level = int(VOLUME.read_text())
        if not 0 <= level <= 100:
            return None
        return level, stat.st_mtime_ns
    except (OSError, ValueError):
        return None


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--seconds', type=float, default=240)
    ap.add_argument('--rotation', type=int, choices=range(4), help='fixed orientation for a manual check; default follows tablet-rotate')
    modes = ap.add_mutually_exclusive_group()
    modes.add_argument('--fm-probe', type=float, metavar='SECONDS', help='bounded muted RF probe; JSON only, no display or GPS')
    modes.add_argument('--render', help='save one logical PNG without opening the display')
    modes.add_argument('--volume-osd', action='store_true', help='brief playback-level overlay, preserving the current screen')
    a = ap.parse_args()
    if not 0 < a.seconds <= 300:
        ap.error('--seconds must be greater than zero and at most 300')
    if a.fm_probe is not None and not 0 < a.fm_probe <= 300:
        ap.error('--fm-probe must be greater than zero and at most 300')
    gps = dict(socket=None, retry=0, buffer=b'', mode=None, used=None, tpv_at=0, sky_at=0, fix_time=None)
    previous = counters()
    tty = fb = mm = None
    original_mode = None
    saved_pixels = None
    fm = None
    started = time.monotonic()
    frames = 0
    cpu_started = time.process_time()
    def stop(*_):
        global STOP
        STOP = True
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    try:
        if a.fm_probe is not None:
            fm = FM()
            probe_deadline = started+a.fm_probe
            while not STOP and time.monotonic() < probe_deadline:
                fm.poll()
                time.sleep(min(0.1, max(0, probe_deadline-time.monotonic())))
            # These are receiver/PCM observations, never GPS coordinates.
            print(json.dumps(dict(status=fm.status, phase=fm.phase, frequency=fm.frequency,
                                  audio=fm.audio, samples=fm.samples, names=fm.names,
                                  bins=fm.bins, audio_at=fm.audio_at, rms_dbfs=fm.level_dbfs,
                                  peak_dbfs=fm.peak_dbfs, clipped=fm.clipped)), flush=True)
            return
        if not a.render:
            if read('/sys/class/tty/tty0/active') != 'tty1':
                raise RuntimeError('tty1 is not active')
            if read('/sys/class/graphics/fb0/virtual_size') != '800,1280' or read('/sys/class/graphics/fb0/stride') != '3200' or read('/sys/class/graphics/fb0/bits_per_pixel') != '32':
                raise RuntimeError('unexpected framebuffer geometry')
            tty = os.open('/dev/tty1', os.O_RDWR | os.O_NOCTTY)
            fcntl.flock(tty, fcntl.LOCK_EX | fcntl.LOCK_NB)
            original_mode = struct.unpack('i', fcntl.ioctl(tty, 0x4B3B, b'\0'*4))[0]
            if original_mode != 0:
                raise RuntimeError('console already in graphics mode')
            fb = os.open('/dev/fb0', os.O_RDWR)
            mm = mmap.mmap(fb, 3200*1280, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
            if a.volume_osd:
                saved_pixels = mm[:]
            fcntl.ioctl(tty, 0x4B3A, 1)
        if not a.volume_osd:
            fm = FM(enabled=not a.render)
        next_stats, old_rotation, base = 0, None, None
        old_fm_view, next_draw = None, 0
        target, origin, moved_at, next_move = (0,0), (0,0), started, started+2
        blink_at = started + random.uniform(4, 7)
        deadline = None
        volume_stamp, volume_until = None, 0
        # Standalone OSD lifetime belongs to the controller, avoiding expiry/update races.
        while not STOP and (a.volume_osd or deadline is None or time.monotonic() < deadline):
            now = time.monotonic()
            rotation = a.rotation if a.rotation is not None else int(read(ROTATION, '0'))
            status = volume_status()
            if status is not None and status[1] != volume_stamp:
                if volume_stamp is not None or time.time()-status[1]/1e9 < 2:
                    volume_until = now+2
                volume_stamp = status[1]
            if not a.volume_osd:
                gps_poll(gps)
                fm.poll()
            if a.volume_osd:
                if saved_pixels is not None:
                    base = Image.frombytes('RGB', (800,1280), saved_pixels, 'raw', 'BGRX')
                    base = physical(base, (-rotation) % 4)
                else:
                    base = Image.new('L', (1280,800) if rotation % 2 else (800,1280))
            else:
                if now >= next_stats or rotation != old_rotation:
                    previous, sections = telemetry(previous, gps)
                    next_stats = now+1
                fm_view = (fm.frequency, fm.status, fm.audio, fm.audio_at,
                           bool(fm.audio_at and now-fm.audio_at <= 0.5), len(fm.samples), len(fm.names))
                if now >= next_draw or rotation != old_rotation or fm_view != old_fm_view:
                    base = background(rotation, sections, started+a.seconds, fm)
                    if rotation != old_rotation:
                        print(f'tablet-sentinel: rotation {rotation}, logical {base.width}x{base.height}', flush=True)
                    old_rotation, old_fm_view, next_draw = rotation, fm_view, now+0.25
            t = min(1, (now-moved_at)/0.7)
            eased = t*t*(3-2*t)
            offset = tuple(origin[i]+(target[i]-origin[i])*eased for i in range(2))
            if now >= next_move:
                origin, target, moved_at = offset, (random.randint(-35,35), random.randint(-16,16)), now
                next_move = now + random.uniform(2, 4)
            openness = max(0.04, abs(now-blink_at)/0.12) if abs(now-blink_at) < 0.12 else 1
            if now > blink_at+0.12:
                blink_at = now+random.uniform(4, 8)
            image = base.copy() if a.volume_osd else frame(base, offset, openness, compact=True)
            if status is not None and (a.volume_osd or now < volume_until):
                volume_overlay(image, status[0])
            if a.render:
                image.save(a.render)
                break
            mm[:] = physical(image, rotation).convert('RGBA').tobytes('raw', 'BGRA')
            if deadline is None:
                deadline = time.monotonic()+a.seconds
            frames += 1
            time.sleep(max(0, 0.1-(time.monotonic()-now)))
    finally:
        try:
            if fm is not None:
                fm.close()
        finally:
            try:
                try:
                    try:
                        if mm is not None:
                            try:
                                if saved_pixels is not None:
                                    mm[:] = saved_pixels
                            finally:
                                mm.close()
                    finally:
                        if fb is not None:
                            os.close(fb)
                finally:
                    if tty is not None:
                        try:
                            if original_mode == 0:
                                fcntl.ioctl(tty, 0x4B3A, original_mode)
                        finally:
                            os.close(tty)
            finally:
                if gps['socket'] is not None:
                    gps['socket'].close()
                elapsed = max(0.001, time.monotonic()-started)
                print(f'tablet-sentinel: {frames} frames in {elapsed:.2f}s, {frames/elapsed:.1f} fps, {time.process_time()-cpu_started:.2f}s CPU', file=sys.stderr, flush=True)



if __name__ == '__main__':
    main()
