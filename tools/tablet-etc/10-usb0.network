[Match]
Name=usb0

[Network]
Address=192.168.77.2/24
DNS=8.8.8.8
DNS=1.1.1.1
KeepConfiguration=yes
IPv6AcceptRA=no

[Link]
# host mode (USB keyboard) leaves usb0 without carrier: do not hold network-online.target for it
RequiredForOnline=no

[Route]
# only a fallback: Wi-Fi (metric 600) stays the default route while a computer is plugged in
# (the laptop routes for the tablet only after tools/host-setup.sh + tab.py up)
Gateway=192.168.77.1
Metric=1000
