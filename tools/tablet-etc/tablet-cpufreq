#!/usr/bin/python3
"""Minimal CPU DVFS for the MT6750 tablet on mainline (no cpufreq driver for MT6755 yet).

Two operating points, chosen by load (polled once a second from /proc/stat):
  HIGH: what lk/preloader leave: big ARMBPLL 871 MHz, little ARMSPLL 689 MHz, VPROC 1.00 V
  LOW : big 286 MHz, little 156 MHz, VPROC 0.90 V (stock OPP table: both need 0.80 V there;
        VSRAM_PROC stays at 1.10 V, within stock's VSRAM - VPROC <= 0.2 V)
Measured with the screen off: 157 mA -> 130 mA system load.

Switching: up = voltage first, then clocks; down = clocks first, then voltage. A PLL is retuned
with its cluster's CPU clock parked on the 26 MHz crystal (TOP_CKMUXSEL), as stock does.
Load = the busiest CPU's. Go LOW after DOWN_SECS below DOWN_LOAD; HIGH as soon as one second
exceeds UP_LOAD.
On SIGTERM the HIGH point is restored.
Thermal cap (no kernel cooling maps yet): at >= HOT_C on the cpu-thermal zone the CPUs are held
at LOW whatever the load, until a valid reading at or below COOL_C (the zone's "hot" trip is 90 C);
unreadable samples while capped keep LOW.
Fail-safe: with no valid temperature for SENSOR_GRACE seconds (from start, or since the last good
reading) the CPUs are also held at LOW - logged as a warning - until the next valid reading below
HOT_C. A missing zone is looked for again every RESCAN seconds. CPUFREQ_NO_SENSOR=allow (in a
drop-in: [Service] Environment=CPUFREQ_NO_SENSOR=allow) runs without a sensor at full speed.
The current point and cap reason are in STATUS_FILE (shown by tablet-status).
"""
import mmap, os, signal, struct, sys, time

UP_LOAD, DOWN_LOAD, DOWN_SECS = 0.50, 0.20, 5
HOT_C = float(os.environ.get("CPUFREQ_HOT_C", 85))      # overridable for tests
COOL_C = float(os.environ.get("CPUFREQ_COOL_C", 75))
SENSOR_GRACE = float(os.environ.get("CPUFREQ_SENSOR_GRACE", 60))
RESCAN = 30
ALLOW_NO_SENSOR = os.environ.get("CPUFREQ_NO_SENSOR") == "allow"
STATUS_FILE = "/run/tablet-cpufreq"
PMIC_REG = "/sys/kernel/mt6755_pmic/reg"
VPROC_VOSEL = 0x060a                    # MT6353 BUCK_VPROC_VOSEL (SW mode): 0.6 V + 6.25 mV * n
CLUSTERS = (("big", 0x200, 4), ("little", 0x210, 8))  # ARM PLL base in APMIXED, CKMUXSEL shift
LOW = {"big": 0x020b0000, "little": 0x030c0000, "vproc": 0x30}
BOOT = {"big": 0x0110c000, "little": 0x010d4000, "vproc": 0x40}   # lk/preloader values

fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
infra = mmap.mmap(fd, 0x1000, offset=0x10001000)
apmix = mmap.mmap(fd, 0x1000, offset=0x1000c000)


def rd(m, o):
    return struct.unpack_from("<I", m, o)[0]


def wr(m, o, v):
    struct.pack_into("<I", m, o, v)


def pmic(addr, val=None):
    with open(PMIC_REG, "w") as f:
        f.write(f"{addr:#x}" if val is None else f"{addr:#x} {val:#x}")
    if val is None:
        with open(PMIC_REG) as f:
            return int(f.read().split()[1], 16)


def retune(base, shift, con1):
    if rd(apmix, base + 4) & 0x07ffffff == con1 & 0x07ffffff:
        return
    wr(infra, 0, rd(infra, 0) & ~(3 << shift))                   # cluster clock -> 26 MHz
    time.sleep(0.0005)
    wr(apmix, base + 4, (1 << 31) | (con1 & 0x07ffffff))
    time.sleep(0.0005)                                           # PLL settles in ~20 us
    wr(infra, 0, (rd(infra, 0) & ~(3 << shift)) | (1 << shift))  # -> ARM PLL


def apply(opp, going_up):
    if going_up:
        pmic(VPROC_VOSEL, opp["vproc"])
        time.sleep(0.001)                                        # ~12.5 mV/us slew, 100 mV
    for name, base, shift in CLUSTERS:
        retune(base, shift, opp[name])
    if not going_up:
        pmic(VPROC_VOSEL, opp["vproc"])


def cpu_times():
    """(busy, total) jiffies per online CPU"""
    out = {}
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("cpu") and line[3].isdigit():
                n, *v = line.split()
                v = [int(x) for x in v]
                idle = v[3] + v[4]
                out[n] = (sum(v) - idle, sum(v))
    return out


def cpu_temp_path():
    for z in sorted(os.listdir("/sys/class/thermal")):
        try:
            if open(f"/sys/class/thermal/{z}/type").read().strip() == "cpu-thermal":
                return f"/sys/class/thermal/{z}/temp"
        except OSError:
            pass
    return None


def cpu_temp(path):
    """degrees C, or None if unreadable"""
    try:
        return int(open(path).read()) / 1000
    except (OSError, ValueError, TypeError):
        return None


def log(msg, warn=False):
    print(("<4>" if warn else "") + "tablet-cpufreq: " + msg, flush=True)   # <4>: journal warning
    if warn:
        try:
            with open("/dev/kmsg", "w") as f:
                f.write("<4>tablet-cpufreq: " + msg + "\n")
        except OSError:
            pass


def set_status(text):
    try:
        with open(STATUS_FILE + ".tmp", "w") as f:
            f.write(text + "\n")
        os.replace(STATUS_FILE + ".tmp", STATUS_FILE)
    except OSError:
        pass


def main():
    high = {name: rd(apmix, base + 4) & 0x07ffffff for name, base, _ in CLUSTERS}
    high["vproc"] = pmic(VPROC_VOSEL)
    if high["vproc"] <= LOW["vproc"] or high["big"] == LOW["big"]:
        high = dict(BOOT)           # restarted while at LOW: HIGH = the boot point
    # Start from HIGH in hardware too, so the logical state below matches the chip (after a crash
    # or SIGKILL at LOW, the loop would otherwise believe HIGH while the CPUs stay at LOW).
    apply(high, True)
    print(f"tablet-cpufreq: HIGH big=0x{high['big']:08x} little=0x{high['little']:08x} "
          f"vproc=0x{high['vproc']:02x}", flush=True)

    def stop(*_):
        apply(high, True)
        try:
            os.unlink(STATUS_FILE)
        except OSError:
            pass
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    tpath = cpu_temp_path()
    log(f"thermal cap {HOT_C:.0f} C (release {COOL_C:.0f} C) on {tpath or 'NO cpu-thermal zone yet'}; "
        + ("no sensor: full speed allowed (CPUFREQ_NO_SENSOR=allow)" if ALLOW_NO_SENSOR else
           f"fail-safe: LOW after {SENSOR_GRACE:.0f} s without a valid reading"))
    state, quiet = "HIGH", 0
    cap = None                  # None, "hot" (>= HOT_C) or "sensor" (fail-safe: no valid reading)
    blind, shown = False, None
    last_ok = last_scan = time.monotonic()      # the grace period starts with the service
    prev = cpu_times()
    while True:
        time.sleep(1)
        cur = cpu_times()
        # busiest CPU decides: one single-threaded job must get the fast clock
        load = max(((b - prev[c][0]) / max(1, t - prev[c][1])
                    for c, (b, t) in cur.items() if c in prev), default=0)
        prev = cur
        now = time.monotonic()
        temp = cpu_temp(tpath)
        if temp is None and now - last_scan >= RESCAN:          # zone missing or gone: look again
            last_scan = now
            p = cpu_temp_path()
            if p != tpath:
                log(f"cpu-thermal zone now {p or 'missing'}")
                tpath = p
                temp = cpu_temp(tpath)
        if temp is not None:
            last_ok = now
        if temp is not None and temp >= HOT_C and cap != "hot":
            cap = "hot"
            log(f"{temp:.1f} C >= {HOT_C:.0f} C: held at LOW")
        elif cap == "hot" and temp is not None and temp <= COOL_C:
            cap = None
            log(f"{temp:.1f} C: thermal cap released")
        elif cap == "sensor" and temp is not None:              # here temp < HOT_C
            cap = None
            log(f"CPU temperature readable again ({temp:.1f} C): fail-safe cap released")
        elif (cap is None and temp is None and not ALLOW_NO_SENSOR
              and now - last_ok >= SENSOR_GRACE):
            cap = "sensor"
            log(f"no valid CPU temperature for {now - last_ok:.0f} s: held at LOW (fail-safe)",
                warn=True)
        elif cap == "hot" and temp is None and not blind:
            # a failed read is not evidence of cooling: stay at LOW until a valid reading
            log("temperature unreadable while capped: staying at LOW")
        blind = temp is None
        if cap:
            if state == "HIGH":
                apply(LOW, False)
                state = "LOW"
        elif state == "LOW" and load > UP_LOAD:
            apply(high, True)
            state, quiet = "HIGH", 0
        elif state == "HIGH":
            quiet = quiet + 1 if load < DOWN_LOAD else 0
            if quiet >= DOWN_SECS:
                apply(LOW, False)
                state = "LOW"
        text = state + {None: "", "hot": " (capped: CPU hot)",
                        "sensor": " (capped: no CPU temperature, fail-safe)"}[cap]
        if text != shown:
            set_status(text)
            shown = text


if __name__ == "__main__":
    main()
