[Unit]
Description=MT6353 PMIC charger keep-alive (mainline kernel, until a kernel driver exists)
ConditionKernelVersion=>=6
ConditionPathExists=/dev/mem
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
ExecStart=/usr/local/sbin/mt6353-charger run
Restart=always
RestartSec=2

[Install]
WantedBy=sysinit.target
